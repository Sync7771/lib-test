-- LÓGICA DE SCAN E COMANDOS
local backdoorRemote = nil
local selectedTarget = ""

local function sendCmd(code)
    if not backdoorRemote then return end
    pcall(function()
        if backdoorRemote:IsA("RemoteEvent") then backdoorRemote:FireServer(code) else backdoorRemote:InvokeServer(code) end
    end)
end

-- FUNÇÃO PARA CRIAR BOTÃO
local function createBtn(parent, text, callback, layout)
    local b = Instance.new("TextButton", parent)
    b.LayoutOrder = layout or 1
    b.BackgroundColor3 = Color3.fromRGB(50, 15, 15)
    b.Text = text; b.Font = Enum.Font.GothamMedium; b.TextSize = 12
    b.TextColor3 = Color3.fromRGB(255, 200, 200); b.BorderSizePixel = 0; b.AutoButtonColor = false
    Instance.new("UICorner", b).CornerRadius = UDim.new(0, 6)
    local s = Instance.new("UIStroke", b); s.Color = Color3.fromRGB(150, 0, 0)
    b.MouseEnter:Connect(function() b.BackgroundColor3 = Color3.fromRGB(80, 20, 20) end)
    b.MouseLeave:Connect(function() b.BackgroundColor3 = Color3.fromRGB(50, 15, 15) end)
    b.MouseButton1Click:Connect(callback)
    return b
end

