local ANTI = {
    enabled = false,
    cap = 8,
    lagTag = "LagPart",
    scanRate = 0.05,
    threads = {},
    lastTrim = 0,
    stripped = 0,
}

local function isLagName(name)
    local u = name:upper()
    return u:find("HACKED") or u:find("LAG") or u:find("SPAM")
        or u:find("FLY")   or u:find("CRIPTO") or u:find("EXPLOIT")
        or u:find("BOT")   or u:find("DUPE")
end

local function isLagPart(part)
    if not part:IsA("BasePart") then return false end
    if CollectionService:HasTag(part, ANTI.lagTag) then return true end
    if part:FindFirstChildOfClass("BodyVelocity")
        or part:FindFirstChildOfClass("BodyAngularVelocity")
        or part:FindFirstChildOfClass("BodyPosition")
        or part:FindFirstChildOfClass("BodyThrust")
        or part:FindFirstChildOfClass("BodyForce")
        or part:FindFirstChildOfClass("BodyGyro") then
        return true
    end
    if isLagName(part.Name) and part.Anchored then return true end
    return false
end

local function trimLocalBackpack()
    local bp = LP:FindFirstChild("Backpack")
    if not bp then return end
    local tools = {}
    for _, c in ipairs(bp:GetChildren()) do
        if c:IsA("Tool") then table.insert(tools, c) end
    end
    if #tools <= ANTI.cap then return end
    for i = #tools, ANTI.cap + 1, -1 do
        pcall(function() tools[i]:Destroy() end)
        ANTI.stripped = ANTI.stripped + 1
    end
    ANTI.lastTrim = os.clock()
end

local function cleanLocalCharacter()
    local char = LP.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    if root then
        for _, v in ipairs(root:GetChildren()) do
            if v:IsA("BodyVelocity") or v:IsA("BodyAngularVelocity")
                or v:IsA("BodyPosition") or v:IsA("BodyThrust")
                or v:IsA("BodyForce") or v:IsA("BodyGyro") then
                pcall(function() v:Destroy() end)
            end
        end
    end
    for _, d in ipairs(char:GetDescendants()) do
        if d:IsA("Tool") and isLagName(d.Name) then
            pcall(function() d:Destroy() end)
            ANTI.stripped = ANTI.stripped + 1
        end
    end
end

local function sweepWorkspace()
    local char = LP.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local origin = root and root.Position or Vector3.new(0, 0, 0)
    for _, part in ipairs(workspace:GetChildren()) do
        if isLagPart(part) and (part.Position - origin).Magnitude < 150 then
            pcall(function() part:Destroy() end)
            ANTI.stripped = ANTI.stripped + 1
        end
    end
end

local function onTagAdded(part)
    if not ANTI.enabled then return end
    if CollectionService:HasTag(part, ANTI.lagTag) then
        pcall(function() part:Destroy() end)
        ANTI.stripped = ANTI.stripped + 1
    end
end

local function startLoops()
    for _, conn in ipairs(ANTI.threads) do
        pcall(function() conn:Disconnect() end)
    end
    ANTI.threads = {}

    table.insert(ANTI.threads, RunService.Heartbeat:Connect(function()
        if not ANTI.enabled then return end
        trimLocalBackpack()
        cleanLocalCharacter()
    end))

    table.insert(ANTI.threads, task.spawn(function()
        while ANTI.enabled do
            pcall(sweepWorkspace)
            task.wait(ANTI.scanRate)
        end
    end))

    table.insert(ANTI.threads, CollectionService:GetInstanceAddedSignal(ANTI.lagTag):Connect(onTagAdded))

    local bp = LP:FindFirstChild("Backpack")
    if bp then
        table.insert(ANTI.threads, bp.ChildAdded:Connect(function()
            if not ANTI.enabled then return end
            task.wait(0.02)
            trimLocalBackpack()
        end))
    end

    if LP.Character then
        table.insert(ANTI.threads, LP.CharacterAdded:Connect(function(char)
            task.wait(0.5)
            if ANTI.enabled then
                trimLocalBackpack()
                cleanLocalCharacter()
            end
        end))
    end
end

local function stopLoops()
    for _, conn in ipairs(ANTI.threads) do
        pcall(function() conn:Disconnect() end)
    end
    ANTI.threads = {}
end

local function setAntiLag(state)
    ANTI.enabled = state
    if state then
        startLoops()
        pcall(sweepWorkspace)
        pcall(trimLocalBackpack)
        pcall(cleanLocalCharacter)
    else
        stopLoops()
    end
end

