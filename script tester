local function sendCmd(cmd, args)
    if not backdoorRemote then 
        win:Notify({Title = "Aviso", Content = "Rode o INJECT primeiro!", Duration = 3})
        return 
    end
    local code = ""
    if cmd == "kick" then
        code = string.format([[local p = game.Players:FindFirstChild("%s") if p then p:Kick("%s") end]], args.target, args.reason or "Kicked")
    elseif cmd == "kill" then
        code = string.format([[local p = game.Players:FindFirstChild("%s") if p and p.Character then p.Character:BreakJoints() end]], args.target)
    elseif cmd == "explode" then
        code = [[
            for _, v in ipairs(workspace:GetDescendants()) do
                if v:IsA("BasePart") then
                    local ex = Instance.new("Explosion")
                    ex.Position = v.Position
                    ex.Parent = workspace
                end
            end
        ]]
    elseif cmd == "lag" then
        code = [[
            for i = 1, 100 do
                task.spawn(function()
                    local p = Instance.new("Part")
                    p.Size = Vector3.new(100,100,100)
                    p.Position = Vector3.new(math.random(-1000,1000), math.random(100,500), math.random(-1000,1000))
                    p.Anchored = false
                    p.Parent = workspace
                    task.delay(3, function() if p then p:Destroy() end end)
                end)
            end
        ]]
    elseif cmd == "rainbow" then
        code = string.format([[
            local p = game.Players:FindFirstChild("%s")
            if p and p.Character then
                task.spawn(function()
                    for i = 1, 200 do
                        if not p.Character then return end
                        local hue = ((tick()*0.4 + i*0.05) % 1)
                        for _, v in ipairs(p.Character:GetDescendants()) do
                            if v:IsA("BasePart") then v.Color = Color3.fromHSV(hue, 1, 1) end
                        end
                        task.wait(0.08)
                    end
                end)
            end
        ]], args.target)
    end
    
    pcall(function()
        if backdoorRemote:IsA("RemoteEvent") then backdoorRemote:FireServer(code) else backdoorRemote:InvokeServer(code) end
    end)
    win:Notify({Title = "Executado", Content = "Comando enviado.", Duration = 2})
end

