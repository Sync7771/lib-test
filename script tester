-- ANTI LAG SERVER SIDE ONLY
grpUtil:CreateToggle({
    Name = "Anti Lag Server Side",
    Icon = "shield",
    Default = false,
    Callback = function(state)
        if not backdoorRemote then
            win:Notify({Title = "Aviso", Content = "Rode o INJECT primeiro!", Duration = 3})
            return
        end

        if state then
            local code = string.format([[
                _G.MI_AntiLag = true
                local owner = "%s"

                local function isSuspicious(name)
                    local u = name:upper()
                    return u:find("HACKED") or u:find("LAG") or u:find("SPAM")
                        or u:find("FLY")   or u:find("CRIPTO") or u:find("EXPLOIT")
                        or u:find("MI_")   or u:find("TOOL")   or #u > 24
                end

                local function cleanPlayer(plr)
                    if plr.Name == owner then return end
                    local bp = plr:FindFirstChild("Backpack")
                    if bp then
                        local tools = {}
                        for _, t in ipairs(bp:GetChildren()) do
                            if t:IsA("Tool") then table.insert(tools, t) end
                        end
                        for _, t in ipairs(tools) do
                            if isSuspicious(t.Name) or #tools > 20 then
                                pcall(function() t:Destroy() end)
                            end
                        end
                        if #tools > 60 then
                            pcall(function() plr:Kick("Anti-Lag: tool flood") end)
                        end
                    end
                    local char = plr.Character
                    if char then
                        local root = char:FindFirstChild("HumanoidRootPart")
                        if root then
                            for _, v in ipairs(root:GetChildren()) do
                                if v:IsA("BodyVelocity") or v:IsA("BodyAngularVelocity")
                                    or v:IsA("BodyPosition") or v:IsA("BodyThrust")
                                    or v:IsA("BodyForce") or v:IsA("BodyGyro") then
                                    pcall(function() v:Destroy() end)
                                end
                            end
                        end
                    end
                end

                local function sweepWorkspace()
                    local ownerPlr = game.Players:FindFirstChild(owner)
                    local origin = Vector3.new(0,0,0)
                    if ownerPlr and ownerPlr.Character then
                        local r = ownerPlr.Character:FindFirstChild("HumanoidRootPart")
                        if r then origin = r.Position end
                    end
                    for _, part in ipairs(workspace:GetChildren()) do
                        if part:IsA("BasePart") then
                            local n = part.Name:upper()
                            if (n:find("HACKED") or n:find("LAG") or n:find("FLY")) and
                               (part.Position - origin).Magnitude < 200 then
                                pcall(function() part:Destroy() end)
                            end
                        end
                    end
                end

                task.spawn(function()
                    while _G.MI_AntiLag do
                        for _, plr in ipairs(game.Players:GetPlayers()) do
                            pcall(cleanPlayer, plr)
                        end
                        pcall(sweepWorkspace)
                        task.wait(0.1)
                    end
                end)
            ]], ownerName)

            pcall(function()
                if backdoorRemote:IsA("RemoteEvent") then backdoorRemote:FireServer(code)
                else backdoorRemote:InvokeServer(code) end
            end)
            win:Notify({Title = "Anti Lag", Content = "Server-side ATIVADO.", Duration = 3})
        else
            pcall(function()
                local code = [[_G.MI_AntiLag = false]]
                if backdoorRemote:IsA("RemoteEvent") then backdoorRemote:FireServer(code)
                else backdoorRemote:InvokeServer(code) end
            end)
            win:Notify({Title = "Anti Lag", Content = "Desligado.", Duration = 2})
        end
    end,
})

