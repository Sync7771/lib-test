-- CRYPTO SERVER TUDO
grpServer:CreateToggle({Name = "CRIPTO SERVER TUDO", Icon = "terminal", Default = false, Callback = function(state)
    if state then
        win:Notify({Title = "Cripto", Content = "Iniciando renomeacao total...", Duration = 3})
        
        local cryptoActive = true
        
        local function scramble(len)
            local chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789abcdefghijklmnopqrstuvwxyz#$%&*+_=/"
            local out = {}
            for i = 1, len do
                local n = math.random(1, #chars)
                out[i] = chars:sub(n, n)
            end
            return table.concat(out)
        end

        local function tag()
            if math.random(1, 100) <= 60 then
                return "HACKED_" .. scramble(math.random(10, 24))
            end
            return scramble(math.random(10, 24))
        end

        local SKIP = {
            Terrain = true, Camera = true, Humanoid = true,
            HumanoidRootPart = true, Head = true, Torso = true,
        }

        local function deepRename(root, depth)
            if depth > 15 then return end
            for _, v in ipairs(root:GetChildren()) do
                pcall(function()
                    if not SKIP[v.Name] then
                        v.Name = tag()
                    end
                end)
                pcall(deepRename, v, depth + 1)
            end
        end

        task.spawn(function()
            while cryptoActive do
                pcall(function() deepRename(workspace, 0) end)
                pcall(function() deepRename(game:GetService("ReplicatedStorage"), 0) end)
                pcall(function() deepRename(game:GetService("Lighting"), 0) end)
                pcall(function() deepRename(game:GetService("StarterGui"), 0) end)
                
                for _, plr in ipairs(Players:GetPlayers()) do
                    if plr.Name ~= ownerName then
                        pcall(function()
                            if plr.Character then deepRename(plr.Character, 0) end
                        end)
                        pcall(function()
                            local bp = plr:FindFirstChild("Backpack")
                            if bp then deepRename(bp, 0) end
                        end)
                        pcall(function()
                            local pg = plr:FindFirstChild("PlayerGui")
                            if pg then deepRename(pg, 0) end
                        end)
                    end
                end
                
                task.wait(0.05)
            end
        end)
        
        -- Guarda a flag para desligar
        getgenv().MI_Crypto_State = true
    else
        getgenv().MI_Crypto_State = false
        win:Notify({Title = "Cripto", Content = "Desligado.", Duration = 2})
    end
end})

