-- GODMODE :FF
grpUtil:CreateToggle({
    Name = "Godmode Vida Infinita FF",
    Icon = "shield",
    Default = false,
    Callback = function(state)
        getgenv().MI_Godmode = state
        
        if state then
            win:Notify({Title = "Godmode", Content = "Ativado.", Duration = 3})
            
            task.spawn(function()
                while getgenv().MI_Godmode do
                    pcall(function()
                        local char = LP.Character
                        if char then
                            local h = char:FindFirstChildOfClass("Humanoid")
                            if h then
                                h.MaxHealth = math.huge
                                h.Health = math.huge
                                h.BreakJointsOnDeath = false
                            end
                            
                            local root = char:FindFirstChild("HumanoidRootPart")
                            if root then
                                root.Anchored = true
                                for _, v in ipairs(root:GetChildren()) do
                                    if v:IsA("BodyVelocity") or v:IsA("BodyAngularVelocity")
                                        or v:IsA("BodyPosition") or v:IsA("BodyThrust")
                                        or v:IsA("BodyForce") or v:IsA("BodyGyro") then
                                        v:Destroy()
