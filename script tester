-- language: Lua, target: Roblox
-- Painel Inferno adaptado para AURA UI

local Aura = loadstring(game:HttpGet("https://raw.githubusercontent.com/Sync7771/lib-test/refs/heads/main/AURA%20HUB"))()

local win = Aura:CreateWindow({
    Title = "MI HUB | HELL", 
    Subtitle = "Administration & Server",
    Theme = "HighContrast", 
    Size = Vector2.new(680, 480),
    ToggleKey = Enum.KeyCode.RightControl
})

-- Aplica o degradê vermelho e a bolinha com o nome "MI"
win:SetTitleGradient({From = "#FF0000", To = "#8B0000", Rotation = 45})
win:SetFloatingButton({Text = "MI", Size = 50, TextColor = Color3.fromRGB(255, 0, 0)})
win:SetAccent(Color3.fromRGB(255, 0, 0))

local selectedTarget = nil

-- ABA: ADMINISTRAÇÃO
local tabAdmin = win:CreateTab({Name = "Admin", Icon = "shield"})
local grpPlayer = tabAdmin:CreateGroup({Name = "Alvo Selecionado", Description = "Escolha o alvo ou use All"})

grpPlayer:CreatePlayerList({
    Name = "Jogadores",
    Height = 150,
    Multi = false,
    Callback = function(player)
        if player then
            selectedTarget = player.Name
            win:Notify({Title = "Alvo definido", Content = "Jogador: " .. selectedTarget, Duration = 3})
        end
    end
})

local targetLabel = grpPlayer:CreateLabel({Name = "Nenhum jogador selecionado"})

grpPlayer:CreateButton({
    Name = "Selecionar Todos (ALL)",
    Icon = "users",
    Callback = function()
        selectedTarget = "ALL"
        targetLabel:Set("Alvo: TODOS (Exceto você)")
        win:Notify({Title = "Alvo Global", Content = "Todos os jogadores selecionados.", Duration = 3})
    end
})

tabAdmin:CreateSpacer(12)

local grpAcoes = tabAdmin:CreateGroup({Name = "Ações de Admin"})
grpAcoes:CreateButton({
    Name = "Kick Alvo",
    Icon = "user-x",
    Callback = function()
        if not selectedTarget then return win:Notify({Title = "Erro", Content = "Selecione um alvo primeiro."}) end
        local reason = "Kicked by MI HUB"
        if selectedTarget == "ALL" then
            for _, p in ipairs(game:GetService("Players"):GetPlayers()) do
                if p ~= game:GetService("Players").LocalPlayer then p:Kick(reason) end
            end
        else
            local p = game:GetService("Players"):FindFirstChild(selectedTarget)
            if p then p:Kick(reason) end
        end
    end
})

grpAcoes:CreateButton({
    Name = "Matar Alvo",
    Icon = "skull",
    Callback = function()
        if not selectedTarget then return win:Notify({Title = "Erro", Content = "Selecione um alvo."}) end
        local function kill(p)
            local h = p.Character and p.Character:FindFirstChildOfClass("Humanoid")
            if h then h.Health = 0 end
        end
        if selectedTarget == "ALL" then
            for _, p in ipairs(game:GetService("Players"):GetPlayers()) do
                if p ~= game:GetService("Players").LocalPlayer then kill(p) end
            end
        else
            local p = game:GetService("Players"):FindFirstChild(selectedTarget)
            if p then kill(p) end
        end
    end
})

-- ABA: SERVER
local tabServer = win:CreateTab({Name = "Server", Icon = "server"})
local grpServer = tabServer:CreateGroup({Name = "Destruição", Description = "Ferramentas de estresse do servidor"})

grpServer:CreateButton({
    Name = "Lag Server (Heavy)",
    Icon = "zap",
    Callback = function()
        for _ = 1, 50 do
            task.spawn(function()
                local p = Instance.new("Part")
                p.Size = Vector3.new(100, 100, 100)
                p.Position = Vector3.new(math.random(-1000, 1000), math.random(100, 500), math.random(-1000, 1000))
                p.Anchored = false
                p.Parent = workspace
                task.delay(3, function() if p then p:Destroy() end end)
            end)
        end
    end
})

grpServer:CreateButton({
    Name = "Destruir Workspace",
    Icon = "trash-2",
    Callback = function()
        for _, v in ipairs(workspace:GetChildren()) do
            if v:IsA("Model") or v:IsA("BasePart") then
                pcall(function() v:Destroy() end)
            end
        end
    end
})

grpServer:CreateButton({
    Name = "Kick All (Wipe)",
    Icon = "server-off",
    Callback = function()
        for _, p in ipairs(game:GetService("Players"):GetPlayers()) do
            if p ~= game:GetService("Players").LocalPlayer then p:Kick("Server Wiped") end
        end
    end
})

win:Notify({Title = "MI HUB", Content = "Carregado com sucesso. RightCtrl para abrir/fechar.", Duration = 5})
