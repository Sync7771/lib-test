local function sendCmd(cmd, args)
    if not backdoorRemote then 
        win:Notify({Title = "Aviso", Content = "Rode o INJECT primeiro!", Duration = 3})
        return 
    end
    local code = ""
    if cmd == "kick" then
        code = string.format([[local p = game.Players:FindFirstChild("%s") if p then p:Kick("%s") end]], args.target, args.reason or "Kicked")
    elseif cmd == "kill" then
        code = string.format([[local p = game.Players:FindFirstChild("%s") if p and p.Character then p.Character:BreakJoints() end]], args.target)
    elseif cmd == "explode" then
        code = [[
            for _, v in ipairs(workspace:GetDescendants()) do
                if v:IsA("BasePart") then
                    local ex = Instance.new("Explosion")
                    ex.Position = v.Position
                    ex.Parent = workspace
                end
            end
        ]]
    elseif cmd == "lag" then
        code = [[
            task.spawn(function()
                while true do
                    for i = 1, 80 do
                        local p = Instance.new("Part")
                        p.Size = Vector3.new(4,4,4)
                        p.Anchored = true
                        p.CanCollide = false
                        p.Transparency = 1
                        p.Parent = workspace
                    end
                    task.wait(0.05)
                end
            end)
        ]]
    elseif cmd == "godmode_on" then
        code = string.format([[
            local p = game.Players:FindFirstChild("%s")
            if p and p.Character then
                local h = p.Character:FindFirstChildOfClass("Humanoid")
                if h then h.MaxHealth = math.huge; h.Health = math.huge end
                local r = p.Character:FindFirstChild("HumanoidRootPart")
                if r then r.Anchored = true end
            end
        ]], args.target)
    elseif cmd == "godmode_off" then
        code = string.format([[
            local p = game.Players:FindFirstChild("%s")
            if p and p.Character then
                local h = p.Character:FindFirstChildOfClass("Humanoid")
                if h then h.MaxHealth = 100; h.Health = 100 end
                local r = p.Character:FindFirstChild("HumanoidRootPart")
                if r then r.Anchored = false end
            end
        ]], args.target)
    elseif cmd == "invis_on" then
        code = string.format([[
            local p = game.Players:FindFirstChild("%s")
            if p and p.Character then
                for _, v in ipairs(p.Character:GetDescendants()) do
                    if v:IsA("BasePart") then v.Transparency = 1 end
                end
            end
        ]], args.target)
    elseif cmd == "invis_off" then
        code = string.format([[
            local p = game.Players:FindFirstChild("%s")
            if p and p.Character then
                for _, v in ipairs(p.Character:GetDescendants()) do
                    if v:IsA("BasePart") then v.Transparency = 0 end
                end
            end
        ]], args.target)
    end
    
    pcall(function()
        if backdoorRemote:IsA("RemoteEvent") then backdoorRemote:FireServer(code) else backdoorRemote:InvokeServer(code) end
    end)
    win:Notify({Title = "Executado", Content = "Comando enviado.", Duration = 2})
end

