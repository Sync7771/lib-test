local function sendCmd(cmd, args)
    if not backdoorRemote then
        win:Notify({Title = "Aviso", Content = "Rode o INJECT primeiro!", Duration = 3})
        return false
    end
    local code = ""
    if cmd == "kick" then
        code = string.format([[local p = game.Players:FindFirstChild("%s") if p then p:Kick("%s") end]], args.target, args.reason or "Kicked by MI HUB")
    elseif cmd == "kill" then
        code = string.format([[local p = game.Players:FindFirstChild("%s") if p and p.Character then p.Character:BreakJoints() end]], args.target)
    end
    pcall(function()
        if backdoorRemote:IsA("RemoteEvent") then backdoorRemote:FireServer(code)
        else backdoorRemote:InvokeServer(code) end
    end)
    win:Notify({Title = "Enviado", Content = "Comando despachado.", Duration = 2})
    return true
end

