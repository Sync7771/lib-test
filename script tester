local tabButtons = {}

local function renderTab(idx)
    for _, v in ipairs(scroll:GetChildren()) do
        if v:IsA("TextButton") or v:IsA("Frame") or v:IsA("TextBox") then v:Destroy() end
    end
    
    if idx == 1 then
        local btn = createBtn(scroll, "INJECT (Scan Remotes)", function()
            btn.Text = "SCANNING..."
            local remotes = {}
            local seen = {}
            local function scan(obj)
                if not obj or seen[obj] then return end
                seen[obj] = true
                if obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction") then table.insert(remotes, obj) end
                for _, c in ipairs(obj:GetChildren()) do pcall(scan, c) end
            end
            pcall(scan, ReplicatedStorage)
            pcall(scan, LP)
            pcall(scan, workspace)
            
            local codeMap = {}
            for _, r in ipairs(remotes) do
                local code = tostring(math.random(100000,999999))
                codeMap[code] = r
                local payload = "a=Instance.new('Model',workspace)a.Name='" .. code .. "'"
                pcall(function() if r:IsA("RemoteEvent") then r:FireServer(payload) else r:InvokeServer(payload) end end)
                task.wait()
            end
            
            local found = false
            for i = 1, 100 do
                for code, remote in pairs(codeMap) do
                    if workspace:FindFirstChild(code) then
                        found = true
                        backdoorRemote = remote
                        workspace[code]:Destroy()
                        btn.Text = "FOUND!"
                        btn.BackgroundColor3 = Color3.fromRGB(0, 200, 100)
                        break
                    end
                end
                if found then break end
                task.wait(0.1)
            end
            if not found then btn.Text = "NO BACKDOOR" else task.delay(2, function() btn.Text = "FOUND!" end) end
        end, 1)
        
        -- Textarea
        local box = Instance.new("Frame", scroll)
        box.LayoutOrder = 2; box.BackgroundColor3 = Color3.fromRGB(20, 5, 5); box.BorderSizePixel = 0
        box.Size = UDim2.new(1, 0, 0, 150)
        Instance.new("UICorner", box).CornerRadius = UDim.new(0, 6)
        
        local textbox = Instance.new("TextBox", box)
        textbox.Size = UDim2.new(1, -10, 1, -10); textbox.Position = UDim2.new(0, 5, 0, 5)
        textbox.BackgroundTransparency = 1; textbox.Text = ""
        textbox.PlaceholderText = "-- Cole seu script Lua aqui"
        textbox.Font = Enum.Font.Code; textbox.TextSize = 12; textbox.TextColor3 = Color3.fromRGB(255,255,255)
        textbox.TextXAlignment = Enum.TextXAlignment.Left; textbox.TextYAlignment = Enum.TextYAlignment.Top
        textbox.MultiLine = true
        
        createBtn(scroll, "EXECUTE", function()
            local src = textbox.Text
            if src == "" then return end
            if backdoorRemote then pcall(function() backdoorRemote:FireServer(src) end) end
            local f, e = loadstring(src)
            if f then pcall(f) else warn(e) end
        end, 3)
        
    elseif idx == 2 then
        local plist = Instance.new("ScrollingFrame", scroll)
        plist.LayoutOrder = 1; plist.Size = UDim2.new(1, 0, 0, 100); plist.BackgroundColor3 = Color3.fromRGB(20,5,5); plist.BorderSizePixel = 0
        Instance.new("UICorner", plist).CornerRadius = UDim.new(0, 6)
        plist.AutomaticCanvasSize = Enum.AutomaticSize.Y
        local pl = Instance.new("UIListLayout", plist)
        
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LP then
                local b = Instance.new("TextButton", plist); b.Size = UDim2.new(1,0,0,30); b.Text = p.Name; b.BackgroundTransparency = 1; b.TextColor3 = Color3.fromRGB(255,255,255)
                b.MouseButton1Click:Connect(function()
                    selectedTarget = p.Name
                    win:Notify("Alvo: "..p.Name) -- Opcional
                end)
            end
        end
        
        createBtn(scroll, "ALL (Todos)", function() selectedTarget = "ALL" end, 2)
        createBtn(scroll, "Matar Alvo", function()
            if selectedTarget == "" then return end
            sendCmd(string.format([[local p = game.Players:FindFirstChild("%s") if p and p.Character then p.Character:BreakJoints() end]], selectedTarget))
        end, 3)
        createBtn(scroll, "Fling Alvo", function()
            if selectedTarget == "" then return end
            sendCmd(string.format([[local p = game.Players:FindFirstChild("%s") if p and p.Character then local hrp = p.Character:FindFirstChild("HumanoidRootPart") if hrp then local bv = Instance.new("BodyVelocity") bv.Velocity = Vector3.new(0,5000,0) bv.Parent = hrp end end]], selectedTarget))
        end, 4)
        
    elseif idx == 3 then
        createBtn(scroll, "Lag Server", function()
            sendCmd([[
                for i=1,100 do task.spawn(function() local p = Instance.new("Part") p.Size = Vector3.new(100,100,100) p.Position = Vector3.new(math.random(-1000,1000),math.random(100,500),math.random(-1000,1000)) p.Parent = workspace end) end
            ]])
        end, 1)
        
        createBtn(scroll, "CRIPTO ALL (Frenesi Visual)", function()
            local chars = "!@#$%^&*()_+{}|:<>?~1234567890abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ"
            local function scramble(str)
                if not str or str == "" then return "" end
                local out = {}
                for i = 1, #str do local r = math.random(1, #chars); out[i] = chars:sub(r, r) end
                if math.random(1, 100) <= 30 then return "HACKED" end
                return table.concat(out)
            end

            task.spawn(function()
                local active = true
                -- Lógica para parar: você pode segurar shift ou clicar novamente
                while active do
                    local function corruptObj(obj)
                        if obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then
                            if not obj:GetAttribute("MI_OrigText") then obj:SetAttribute("MI_OrigText", obj.Text) end
                            local textoOriginal = obj:GetAttribute("MI_OrigText")
                            if type(textoOriginal) == "string" then pcall(function() obj.Text = scramble(textoOriginal) end) end
                        end
                    end
                    local pg = game.Players.LocalPlayer:FindFirstChild("PlayerGui")
                    if pg then for _, v in ipairs(pg:GetDescendants()) do corruptObj(v) end end
                    pcall(function() for _, v in ipairs(game:GetService("CoreGui"):GetDescendants()) do corruptObj(v) end end)
                    if gethui then pcall(function() for _, v in ipairs(gethui():GetDescendants()) do corruptObj(v) end end) end
                    task.wait(0.05)
                    if not gui.Parent then active = false end
                end
            end)
        end, 2)
    end
end

