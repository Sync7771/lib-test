-- language: Lua, target: Roblox Client
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local LP = Players.LocalPlayer

local Aura = loadstring(game:HttpGet("https://raw.githubusercontent.com/Sync7771/lib-test/refs/heads/main/AURA%20HUB"))()

local win = Aura:CreateWindow({
    Title = "MI HUB | HELL", 
    Subtitle = "Admin & Client",
    Theme = "HighContrast", 
    Size = Vector2.new(600, 500),
    ToggleKey = Enum.KeyCode.RightControl
})

win:SetTitleGradient({From = "#FF0000", To = "#8B0000", Rotation = 45})
win:SetFloatingButton({Text = "MI", Size = 50, TextColor = Color3.fromRGB(255, 0, 0)})
win:SetAccent(Color3.fromRGB(255, 0, 0))

local function getHRP()
    local c = LP.Character
    return c and c:FindFirstChild("HumanoidRootPart")
end
local function getHum()
    local c = LP.Character
    return c and c:FindFirstChildOfClass("Humanoid")
end

-- ABA: CLIENT (SEU PERSONAGEM)
local tabClient = win:CreateTab({Name = "Local", Icon = "user"})
local grpSelf = tabClient:CreateGroup({Name = "Seu Personagem"})

grpSelf:CreateButton({Name = "Godmode (Invisível e Invulnerável)", Icon = "shield", Callback = function()
    local h = getHum(); if h then h.MaxHealth = math.huge; h.Health = math.huge end
    local r = getHRP(); if r then r.Anchored = true end
end})

grpSelf:CreateButton({Name = "Resetar", Icon = "refresh-cw", Callback = function()
    local h = getHum(); if h then h.Health = 0 end
end})

grpSelf:CreateButton({Name = "Ficar Invisível", Icon = "eye-off", Callback = function()
    local c = LP.Character; if c then
        for _, v in ipairs(c:GetDescendants()) do
            if v:IsA("BasePart") then v.Transparency = 1 end
        end
    end
end})

-- ABA: SERVER (SIMULAÇÃO LOCAL)
local tabServer = win:CreateTab({Name = "Server", Icon = "server"})
local grpServer = tabServer:CreateGroup({Name = "Destruição Local", Description = "Ações que afetam o seu mapa visível"})

grpServer:CreateButton({Name = "Lag (Criar Partes)", Icon = "zap", Callback = function()
    for _ = 1, 50 do
        task.spawn(function()
            local p = Instance.new("Part")
            p.Size = Vector3.new(100, 100, 100)
            p.Position = Vector3.new(math.random(-500, 500), math.random(100, 300), math.random(-500, 500))
            p.Anchored = false
            p.Parent = workspace
            task.delay(3, function() if p then p:Destroy() end end)
        end)
    end
end})

grpServer:CreateButton({Name = "Quebrar Mapa (Anchored = false)", Icon = "hammer", Callback = function()
    for _, v in ipairs(workspace:GetDescendants()) do
        if v:IsA("BasePart") and v ~= getHRP() then
            pcall(function() v.Anchored = false; v.CanCollide = false end)
        end
    end
end})

grpServer:CreateButton({Name = "Apagar Mapa (Client-side)", Icon = "trash-2", Callback = function()
    for _, v in ipairs(workspace:GetChildren()) do
        if v:IsA("Model") or v:IsA("BasePart") then
            pcall(function() v:Destroy() end)
        end
    end
end})

win:Notify({Title = "MI HUB", Content = "Modo local carregado. Nenhum servidor conectado.", Duration = 5})
