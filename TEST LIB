-- Aura UI Library | Roblox Luau | Client-side
-- Put this file at a public GitHub raw URL and load with loadstring(game:HttpGet(URL))()
local Aura = {}
Aura.__index = Aura
local TweenService = game:GetService('TweenService')
local UIS = game:GetService('UserInputService')
local Players = game:GetService('Players')
local player = Players.LocalPlayer
assert(player, 'Aura UI must run on the client')
local palette = {bg=Color3.fromRGB(17,20,29), panel=Color3.fromRGB(26,30,42), item=Color3.fromRGB(37,42,57), accent=Color3.fromRGB(115,102,255), text=Color3.fromRGB(242,244,255), muted=Color3.fromRGB(161,168,190)}
local function new(class, props, parent)
    local obj = Instance.new(class)
    for k,v in pairs(props or {}) do obj[k]=v end
    obj.Parent=parent
    return obj
end
local function corner(o,r) new('UICorner',{CornerRadius=UDim.new(0,r or 10)},o) end
local function pad(o,n) new('UIPadding',{PaddingTop=UDim.new(0,n),PaddingBottom=UDim.new(0,n),PaddingLeft=UDim.new(0,n),PaddingRight=UDim.new(0,n)},o) end
local function tween(o,props,t) TweenService:Create(o,TweenInfo.new(t or .18,Enum.EasingStyle.Quad,Enum.EasingDirection.Out),props):Play() end
local function label(parent,text,size,color)
    return new('TextLabel',{BackgroundTransparency=1,Size=UDim2.new(1,0,0,24),Font=Enum.Font.GothamMedium,Text=tostring(text),TextSize=size or 14,TextColor3=color or palette.text,TextXAlignment=Enum.TextXAlignment.Left},parent)
end
local function button(parent,text)
    local b=new('TextButton',{Size=UDim2.new(1,0,0,38),BackgroundColor3=palette.item,Text=text,TextColor3=palette.text,Font=Enum.Font.GothamMedium,TextSize=13,AutoButtonColor=false},parent)
    corner(b,9)
    b.MouseEnter:Connect(function() tween(b,{BackgroundColor3=Color3.fromRGB(48,54,74)}) end)
    b.MouseLeave:Connect(function() tween(b,{BackgroundColor3=palette.item}) end)
    return b
end
local function safe(fn,...) if type(fn)=='function' then local ok,err=pcall(fn,...); if not ok then warn('[Aura UI] '..tostring(err)) end end end
local function draggable(frame,handle)
    local dragging,startPos,startInput
    handle.InputBegan:Connect(function(input)
        if input.UserInputType==Enum.UserInputType.MouseButton1 or input.UserInputType==Enum.UserInputType.Touch then
            dragging=true;startInput=input.Position;startPos=frame.Position
            input.Changed:Connect(function() if input.UserInputState==Enum.UserInputState.End then dragging=false end end)
        end
    end)
    UIS.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType==Enum.UserInputType.MouseMovement or input.UserInputType==Enum.UserInputType.Touch) then
            local d=input.Position-startInput
            frame.Position=UDim2.new(startPos.X.Scale,startPos.X.Offset+d.X,startPos.Y.Scale,startPos.Y.Offset+d.Y)
        end
    end)
end
function Aura:CreateWindow(opts)
    opts=opts or {}
    local parent=opts.Parent or (player:WaitForChild('PlayerGui'))
    local old=parent:FindFirstChild('AuraUI_'..(opts.Name or 'Window'))
    if old then old:Destroy() end
    local gui=new('ScreenGui',{Name='AuraUI_'..(opts.Name or 'Window'),ResetOnSpawn=false,IgnoreGuiInset=true,ZIndexBehavior=Enum.ZIndexBehavior.Sibling},parent)
    local main=new('Frame',{Size=UDim2.fromOffset(520,350),Position=UDim2.new(.5,-260,.5,-175),BackgroundColor3=palette.bg,BorderSizePixel=0,ClipsDescendants=true},gui)
    corner(main,14)
    new('UIStroke',{Color=Color3.fromRGB(63,67,91),Thickness=1},main)
    local scale=new('UIScale',{Scale=1},main)
    local function resize()
        local cam=workspace.CurrentCamera
        if cam then local v=cam.ViewportSize; scale.Scale=math.min(1,math.max(.57,math.min(v.X/560,v.Y/390))) end
    end
    resize()
    local viewportConn
    if workspace.CurrentCamera then viewportConn=workspace.CurrentCamera:GetPropertyChangedSignal('ViewportSize'):Connect(resize) end
    local header=new('Frame',{Size=UDim2.new(1,0,0,52),BackgroundColor3=palette.panel,BorderSizePixel=0},main)
    local title=label(header,opts.Name or 'Aura UI',17)
    title.Position=UDim2.fromOffset(16,13);title.Size=UDim2.new(1,-110,0,26)
    local close=new('TextButton',{Size=UDim2.fromOffset(30,30),Position=UDim2.new(1,-38,0,11),BackgroundColor3=palette.item,Text='×',TextSize=22,Font=Enum.Font.GothamBold,TextColor3=palette.text},header);corner(close,8)
    local mini=new('TextButton',{Size=UDim2.fromOffset(30,30),Position=UDim2.new(1,-74,0,11),BackgroundColor3=palette.item,Text='−',TextSize=22,Font=Enum.Font.GothamBold,TextColor3=palette.text},header);corner(mini,8)
    local sidebar=new('ScrollingFrame',{Position=UDim2.fromOffset(10,62),Size=UDim2.new(0,142,1,-72),BackgroundTransparency=1,BorderSizePixel=0,ScrollBarThickness=2,AutomaticCanvasSize=Enum.AutomaticSize.Y,CanvasSize=UDim2.new()},main)
    new('UIListLayout',{Padding=UDim.new(0,7),SortOrder=Enum.SortOrder.LayoutOrder},sidebar)
    local content=new('Frame',{Position=UDim2.fromOffset(164,62),Size=UDim2.new(1,-174,1,-72),BackgroundTransparency=1},main)
    draggable(main,header)
    local minimized=false
    mini.MouseButton1Click:Connect(function()
        minimized=not minimized
        tween(main,{Size=minimized and UDim2.fromOffset(520,52) or UDim2.fromOffset(520,350)})
        mini.Text=minimized and '+' or '−'
    end)
    close.MouseButton1Click:Connect(function() if viewportConn then viewportConn:Disconnect() end; gui:Destroy() end)
    local window={Gui=gui,Main=main,Tabs={},_active=nil}
    function window:Destroy() if viewportConn then viewportConn:Disconnect() end;gui:Destroy() end
    function window:Notify(data)
        data=data or {}
        local note=new('Frame',{Size=UDim2.fromOffset(270,66),Position=UDim2.new(1,-284,1,-80),BackgroundColor3=palette.panel},gui);corner(note,10)
        local txt=label(note,(data.Title or 'Notification')..'  •  '..(data.Content or ''),12)
        txt.TextWrapped=true;txt.Position=UDim2.fromOffset(12,7);txt.Size=UDim2.new(1,-24,1,-14)
        task.delay(data.Duration or 3,function() if note.Parent then note:Destroy() end end)
    end
    function window:CreateTab(name)
        local tabButton=button(sidebar,name)
        local page=new('ScrollingFrame',{Size=UDim2.fromScale(1,1),BackgroundTransparency=1,BorderSizePixel=0,ScrollBarThickness=3,AutomaticCanvasSize=Enum.AutomaticSize.Y,CanvasSize=UDim2.new(),Visible=false},content)
        pad(page,4)
        new('UIListLayout',{Padding=UDim.new(0,8),SortOrder=Enum.SortOrder.LayoutOrder},page)
        local tab={Page=page}
        local function activate()
            for _,entry in ipairs(window.Tabs) do entry.Page.Visible=false;entry.Button.BackgroundColor3=palette.item end
            page.Visible=true;tabButton.BackgroundColor3=palette.accent;window._active=tab
        end
        tabButton.MouseButton1Click:Connect(activate)
        table.insert(window.Tabs,{Page=page,Button=tabButton})
        if #window.Tabs==1 then activate() end
        function tab:CreateLabel(text)
            return label(page,text,13,palette.muted)
        end
        function tab:CreateButton(data)
            data=data or {};local b=button(page,data.Name or 'Button')
            b.MouseButton1Click:Connect(function() safe(data.Callback) end)
            return b
        end
        function tab:CreateToggle(data)
            data=data or {};local value=data.Default==true
            local b=button(page,'')
            local function draw() b.Text=(value and '●  ' or '○  ')..(data.Name or 'Toggle');b.TextColor3=value and palette.accent or palette.text end
            draw()
            b.MouseButton1Click:Connect(function() value=not value;draw();safe(data.Callback,value) end)
            return {Set=function(_,v) value=not not v;draw();safe(data.Callback,value) end,Get=function() return value end}
        end
        function tab:CreateSlider(data)
            data=data or {};local min=tonumber(data.Min) or 0;local max=tonumber(data.Max) or 100
            if max<=min then max=min+1 end
            local step=math.max(tonumber(data.Increment) or 1,.00001)
            local value=math.clamp(tonumber(data.Default) or min,min,max)
            local holder=new('Frame',{Size=UDim2.new(1,0,0,60),BackgroundColor3=palette.item},page);corner(holder,9);pad(holder,9)
            local caption=label(holder,'',13)
            local track=new('Frame',{Position=UDim2.fromOffset(0,35),Size=UDim2.new(1,0,0,7),BackgroundColor3=palette.bg,BorderSizePixel=0},holder);corner(track,4)
            local fill=new('Frame',{Size=UDim2.fromScale(0,1),BackgroundColor3=palette.accent,BorderSizePixel=0},track);corner(fill,4)
            local function set(v,callback)
                value=math.clamp(math.floor((v-min)/step+.5)*step+min,min,max)
                value=math.floor(value*10000+.5)/10000
                caption.Text=(data.Name or 'Slider')..': '..tostring(value)
                fill.Size=UDim2.fromScale((value-min)/(max-min),1)
                if callback then safe(data.Callback,value) end
            end
            set(value,false)
            local sliding=false
            local function update(input)
                local w=track.AbsoluteSize.X
                if w>0 then set(min+math.clamp((input.Position.X-track.AbsolutePosition.X)/w,0,1)*(max-min),true) end
            end
            track.InputBegan:Connect(function(input)
                if input.UserInputType==Enum.UserInputType.MouseButton1 or input.UserInputType==Enum.UserInputType.Touch then sliding=true;update(input) end
            end)
            UIS.InputChanged:Connect(function(input)
                if sliding and (input.UserInputType==Enum.UserInputType.MouseMovement or input.UserInputType==Enum.UserInputType.Touch) then update(input) end
            end)
            UIS.InputEnded:Connect(function(input)
                if input.UserInputType==Enum.UserInputType.MouseButton1 or input.UserInputType==Enum.UserInputType.Touch then sliding=false end
            end)
            return {Set=function(_,v) set(tonumber(v) or min,true) end,Get=function() return value end}
        end
        function tab:CreateTextbox(data)
            data=data or {}
            local box=new('TextBox',{Size=UDim2.new(1,0,0,38),BackgroundColor3=palette.item,Text=tostring(data.Default or ''),PlaceholderText=data.Placeholder or data.Name or 'Type here...',TextColor3=palette.text,PlaceholderColor3=palette.muted,Font=Enum.Font.Gotham,TextSize=13,ClearTextOnFocus=false},page);corner(box,9)
            box.FocusLost:Connect(function(enter) if enter or not data.EnterOnly then safe(data.Callback,box.Text) end end)
            return box
        end
        function tab:CreateDropdown(data)
            data=data or {};local options=data.Options or {};local selected=data.Default
            local holder=new('Frame',{Size=UDim2.new(1,0,0,38),BackgroundTransparency=1,ClipsDescendants=true},page)
            local head=button(holder,(data.Name or 'Dropdown')..': '..tostring(selected or 'Select')..'  ▾')
            local list=new('Frame',{Position=UDim2.fromOffset(0,42),Size=UDim2.new(1,0,0,0),BackgroundTransparency=1},holder)
            new('UIListLayout',{Padding=UDim.new(0,4),SortOrder=Enum.SortOrder.LayoutOrder},list)
            local open=false
            local function rebuild()
                for _,child in ipairs(list:GetChildren()) do if child:IsA('TextButton') then child:Destroy() end end
                for _,opt in ipairs(options) do
                    local b=button(list,tostring(opt))
                    b.MouseButton1Click:Connect(function()
                        selected=opt;head.Text=(data.Name or 'Dropdown')..': '..tostring(opt)..'  ▾';open=false;holder.Size=UDim2.new(1,0,0,38);safe(data.Callback,opt)
                    end)
                end
            end
            rebuild()
            head.MouseButton1Click:Connect(function()
                open=not open
                holder.Size=UDim2.new(1,0,0,open and (42+#options*42) or 38)
                list.Size=UDim2.new(1,0,0,#options*42)
            end)
            return {SetOptions=function(_,items) options=items or {};rebuild();if open then holder.Size=UDim2.new(1,0,0,42+#options*42) end end,Get=function() return selected end}
        end
        return tab
    end
    return window
end
return setmetatable({},Aura)
