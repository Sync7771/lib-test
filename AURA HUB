        Position=UDim2.fromOffset(14,62),Size=UDim2.new(1,-28,0,0),
        CanvasSize=UDim2.new(),AutomaticCanvasSize=Enum.AutomaticSize.Y,
    },root)
    list(holder,4)
    local items={}
    local function selectedList()
        if not multi then return selected end
        local result={}
        for _,choice in ipairs(optionsList) do
            if selected[tostring(choice)] then table.insert(result,choice) end
        end
        return result
    end
    local function updateTitle()
        if multi then trigger.Text=tostring(#selectedList()).." selected  ▾"
        else trigger.Text=tostring(selected or "Select").."  ▾" end
    end
    local function expand(value)
        expanded=value
        local height=math.min(#optionsList,6)*34+8
        tween(w,root,{Size=UDim2.new(1,-5,0,66+(value and height or 0))},.19)
        tween(w,holder,{Size=UDim2.new(1,-28,0,value and height-4 or 0)},.19)
