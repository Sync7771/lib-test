local function copy(t)
    local n = {}; for k,v in pairs(t) do n[k]=v end; return n
end
local function themeFor(value)
    local t=copy(BASE)
    local data=type(value)=="string" and PRESETS[value] or value
    if type(data)=="table" then
        for k,v in pairs(data) do if typeof(v)=="Color3" then t[k]=v end end
    end
    return t
end
local guiWindows=setmetatable({},{__mode="k"})
local function new(class, props, parent)
    local inst=Instance.new(class)
    for key,val in pairs(props or {}) do inst[key]=val end
    if parent then inst.Parent=parent end
    if class=="TextLabel" or class=="TextButton" or class=="TextBox" then
        local ancestor=parent
        while ancestor do
            local w=guiWindows[ancestor]
            if w then
                w._fontSizes[inst]=inst.TextSize
                inst.TextSize=math.floor(inst.TextSize*(w.TextScale or 1)+.5)
                break
            end
            ancestor=ancestor.Parent
        end
    end
    return inst
end
local function round(obj, amount)
    local existing=obj:FindFirstChildOfClass("UICorner")
    if existing then existing.CornerRadius=UDim.new(0,amount or 12);return existing end
    return new("UICorner",{CornerRadius=UDim.new(0,amount or 12)},obj)
end
local function stroke(obj, color, alpha, thickness)
    local border=new("UIStroke", {Color=color,Transparency=alpha or 0,Thickness=thickness or 1, ApplyStrokeMode=Enum.ApplyStrokeMode.Border},obj)
    border:SetAttribute("PDDEV_KeepTextControlStroke",true)
    return border
end
local function padding(obj,l,t,r,b)
    return new("UIPadding",{
        PaddingLeft=UDim.new(0,l or 0), PaddingTop=UDim.new(0,t or 0),
        PaddingRight=UDim.new(0,r or l or 0),PaddingBottom=UDim.new(0,b or t or 0)
    },obj)
end
local function list(obj,gap,horiz)
    return new("UIListLayout",{
        Padding=UDim.new(0,gap or 8),SortOrder=Enum.SortOrder.LayoutOrder,
        FillDirection=horiz and Enum.FillDirection.Horizontal or Enum.FillDirection.Vertical,
        HorizontalAlignment=Enum.HorizontalAlignment.Left,
    },obj)
end
local function bind(w, obj, property, role)
    if role=="Accent"and(property=="TextColor3"or property=="ImageColor3")and w.Theme.AccentText then role="AccentText"end
    obj[property]=w.Theme[role]
    table.insert(w._themeBindings,{object=obj,property=property,role=role})
    return obj
end
local function frame(parent, w, role, radius, clip)
    local f=new(clip and "CanvasGroup" or "Frame",{BackgroundColor3=w.Theme[role or "Surface"],BorderSizePixel=0},parent)
    local corner=radius or 12
    -- Component radii are explicit and consistent with the native controls.
    round(f,corner); bind(w,f,"BackgroundColor3",role or "Surface")
    return f
end
local function textlabel(parent,w,value,size,bold,role)
    local t=new("TextLabel",{
        BackgroundTransparency=1, Text=tostring(value or ""),
        TextColor3=w.Theme[role or "Text"],Font=bold and Enum.Font.GothamBold or Enum.Font.Gotham,
        TextSize=math.max(12,size or 13),TextXAlignment=Enum.TextXAlignment.Left,
        TextYAlignment=Enum.TextYAlignment.Center,TextTruncate=Enum.TextTruncate.AtEnd,
        Size=UDim2.new(1,0,0,22),BorderSizePixel=0,
    },parent)
    bind(w,t,"TextColor3",role or "Text")
    return t
end
local function textbutton(parent,w,value,role)
    local b=new("TextButton",{
        Text=tostring(value or ""),TextSize=13,Font=Enum.Font.GothamMedium,
        TextColor3=w.Theme.Text,BackgroundColor3=w.Theme[role or "SurfaceAlt"],
        AutoButtonColor=false,BorderSizePixel=0,Size=UDim2.fromOffset(100,34),
    },parent)
    round(b,10);bind(w,b,"TextColor3","Text");bind(w,b,"BackgroundColor3",role or "SurfaceAlt")
    bind(w,stroke(b,w.Theme.Stroke,.65,1),"Color","Stroke")
    return b
end
local function tween(w, obj, properties, secs)
    if not obj or not obj.Parent then return end
    if w and not w.Animations then
        for k,v in pairs(properties) do obj[k]=v end
        return
    end
    local tw=TweenService:Create(obj,TweenInfo.new(secs or .18,Enum.EasingStyle.Quart,Enum.EasingDirection.Out),properties)
    tw:Play();return tw
end
local function callback(fn,...)
    if type(fn)~="function" then return end
    local pack=table.pack(...)
    task.spawn(function()
        local ok,err=pcall(fn,table.unpack(pack,1,pack.n))
        if not ok then warn("[AURA CALLBACK]",err) end
    end)
end
local function track(w,signal,fn)
    if #w._connections>600 then
        local live={};for _,c in ipairs(w._connections) do if c.Connected then table.insert(live,c) end end
        w._connections=live
    end
    local connection=signal:Connect(fn)
    table.insert(w._connections,connection)
    return connection
end
local function hover(w,b,roleNormal,roleHover)
    track(w,b.MouseEnter,function() if b.Parent then tween(w,b,{BackgroundColor3=w.Theme[roleHover or "Hover"]},.13) end end)
    track(w,b.MouseLeave,function() if b.Parent then tween(w,b,{BackgroundColor3=w.Theme[roleNormal or "SurfaceAlt"]},.13) end end)
end
local function asopts(arg)
    return type(arg)=="table" and arg or {Name=tostring(arg or "")}
end
local function limitedText(value,limit)
    local text=tostring(value or "")
    if not limit or limit<=0 then return text end
    local ok,index=pcall(utf8.offset,text,math.floor(limit)+1)
    if ok and index then return text:sub(1,index-1) end
    return text
end
