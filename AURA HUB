local silentChangeToken={}

local function encode(value)
    if typeof(value)=="Color3" then return {__aura="Color3",hex=hex(value)} end
    if typeof(value)=="EnumItem" then return {__aura="KeyCode",name=value.Name} end
    if typeof(value)=="Vector2" then return {__aura="Vector2",x=value.X,y=value.Y} end
    if type(value)=="table" then
        local out={};for k,v in pairs(value) do out[k]=encode(v) end;return out
    end
    return value
end
local function decode(value)
    if type(value)~="table" then return value end
    if value.__aura=="Color3" then return fromHex(value.hex) or BASE.Accent end
    if value.__aura=="KeyCode" then return normalizedKey(value.name) or Enum.KeyCode.Unknown end
    if value.__aura=="Vector2" then return Vector2.new(value.x or 0,value.y or 0) end
    local out={};for k,v in pairs(value) do out[k]=decode(v) end;return out
end

function Window:_history(flag,old,newValue)
    if self._applyingHistory then return end
    if old==newValue then return end
    table.insert(self._undo,{flag=flag,old=encode(old),new=encode(newValue)})
    if #self._undo>80 then table.remove(self._undo,1) end
    table.clear(self._redo)
end
function Window:Undo()
    local entry=table.remove(self._undo)
    if not entry then return false end
    local item=self.Flags[entry.flag]
    if item and item.Set then
        self._applyingHistory=true;item:Set(decode(entry.old));self._applyingHistory=false
        table.insert(self._redo,entry);return true
    end
    return false
end
function Window:Redo()
    local entry=table.remove(self._redo)
    if not entry then return false end
    local item=self.Flags[entry.flag]
    if item and item.Set then
        self._applyingHistory=true;item:Set(decode(entry.new));self._applyingHistory=false
        table.insert(self._undo,entry);return true
    end
    return false
end
function Window:_register(handle,options)
    self._counter=self._counter+1
    local flag=options.Flag or ("aura_"..tostring(self._counter))
    if self.Flags[flag] then warn("[AURA] Flag already exists:",flag) end
    self.Flags[flag]=handle
    handle.Flag=flag
    handle._window=self
    handle._search=(tostring(options.Name or "").." "..tostring(options.Description or "")):lower()
    local originalDestroy=handle.Destroy
    function handle:Destroy()
        if self._window.Flags[self.Flag]==self then self._window.Flags[self.Flag]=nil end
        if originalDestroy then originalDestroy(self) end
    end
    return handle
end
function Window:ExportConfig()
    local data={version=Aura.Version,theme=self.ThemeName,size=encode(self:GetSize()),values={}}
    for flag,item in pairs(self.Flags) do
        if item.Get and not item._skipSave then
            local ok,value=pcall(function()return item:Get()end)
            if ok then data.values[flag]=encode(value) end
        end
    end
    local ok,result=pcall(HttpService.JSONEncode,HttpService,data)
    if ok then return result end
    warn("[AURA] Cannot export config:",result);return nil
end
function Window:ImportConfig(json)
    local data
    if type(json)=="string" then
        local ok,res=pcall(HttpService.JSONDecode,HttpService,json)
        if not ok then return false,res end
        data=res
    elseif type(json)=="table" then data=json end
    if type(data)~="table" then return false,"Invalid configuration" end
    if data.theme and PRESETS[data.theme] then self:SetTheme(data.theme) end
    if data.size then
        local size=decode(data.size)
        if typeof(size)=="Vector2" then self:SetSize(size.X,size.Y) end
    end
    for flag,value in pairs(data.values or {}) do
        local item=self.Flags[flag]
        if item and item.Set then pcall(function() item:Set(decode(value),true) end) end
    end
    return true
end
function Window:SaveConfig()
    local json=self:ExportConfig();if not json then return false,"Failed to encode" end
    if type(writefile)=="function" then
        local ok,err=pcall(writefile,self.ConfigFile,json)
        if ok then return true end
        return false,tostring(err)
    end
    return false,"writefile API unavailable; use ExportConfig() instead"
end
function Window:LoadConfig()
    if type(readfile)=="function" then
        local ok,result=pcall(readfile,self.ConfigFile)
        if ok then return self:ImportConfig(result) end
        return false,tostring(result)
    end
    return false,"readfile API unavailable; use ImportConfig() instead"
end
function Window:SetTheme(nameOrTable)
    self.ThemeName=type(nameOrTable)=="string" and nameOrTable or "Custom"
    self.Theme=themeFor(nameOrTable)
    for _,ref in ipairs(self._themeBindings) do
        if ref.object.Parent then ref.object[ref.property]=self.Theme[ref.role] end
    end
    if self._accentGradient then
        self._accentGradient.Color=ColorSequence.new(self.Theme.Accent,self.Theme.AccentSoft)
    end
    return self
end
function Window:SetAccent(color)
    if typeof(color)~="Color3" then return end
    local t=copy(self.Theme);t.Accent=color;t.AccentSoft=color:Lerp(self.Theme.Background,.68)
    self:SetTheme(t)
end
function Window:SetAnimations(enabled)self.Animations=not not enabled end
function Window:SetLanguage(language)
    self.Language=(language=="pt" or language=="en") and language or "pt"
    if self.SearchBox then self.SearchBox.PlaceholderText=self.Language=="pt" and "Pesquisar funções..." or "Search controls..." end
end
function Window:SetSize(a,b)
    local v=typeof(a)=="Vector2" and a or Vector2.new(tonumber(a) or 750,tonumber(b) or 490)
    v=clampSize(self,v);self.Root.Size=UDim2.fromOffset(v.X,v.Y)
    local pos=self.Root.AbsolutePosition
    self.Root.Position=clampPosition(self,Vector2.new(pos.X,pos.Y))
    return v
end
function Window:GetSize()
    return Vector2.new(self.Root.AbsoluteSize.X,self.Root.AbsoluteSize.Y)
end
function Window:Center()
    local view=screenSize();local sz=self:GetSize()
    self.Root.Position=UDim2.fromOffset(math.max(0,(view.X-sz.X)/2),math.max(0,(view.Y-sz.Y)/2))
end
function Window:Toggle()
    self.Root.Visible=not self.Root.Visible
    if self.FloatingButton then self.FloatingButton.Visible=not self.Root.Visible end
    return self.Root.Visible
end
function Window:Minimize(state)
    if state==nil then state=not self.Minimized end
    self.Minimized=state
    if self.Minimized then
        self._unminimizedSize=self:GetSize()
        self.Main.Visible=false;self.Sidebar.Visible=false;self.ResizeHandle.Visible=false
        tween(self,self.Root,{Size=UDim2.fromOffset(math.max(340,self._unminimizedSize.X),64)},.19)
    else
        local s=self._unminimizedSize or Vector2.new(750,490)
        self:SetSize(s);self.Main.Visible=true;self.Sidebar.Visible=true;self.ResizeHandle.Visible=true
    end
end
function Window:Destroy()
    if self.Destroyed then return end
    self.Destroyed=true
    for _,connection in ipairs(self._connections) do connection:Disconnect() end
    table.clear(self._connections)
    if self.Gui then self.Gui:Destroy() end
    if Aura._lastWindow==self then Aura._lastWindow=nil end
end

