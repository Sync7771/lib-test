        Callback=function(v)name=v end})
    tab:CreateButton({Name="Save profile",Callback=function()
        self:SaveProfile(name);options:Refresh(self:GetProfiles())
        Aura:Notify({Title="Profile saved",Content=name,Type="success"})
    end})
    tab:CreateButton({Name="Load profile",Callback=function()
        local ok=self:LoadProfile(name)
        Aura:Notify({Title=ok and "Profile loaded" or "Profile missing",Content=name,Type=ok and "success" or "warn"})
    end})
    tab:CreateButton({Name="Delete profile",Callback=function()
        self:DeleteProfile(name);options:Refresh(self:GetProfiles())
    end})
    return tab
end
