		local function SelectNativeTab()
			if CurrentTab then
				CurrentTab.Page.Visible = false
				CurrentTab.Button.BackgroundColor3 = Theme.TabBackground
				CurrentTab.Button:SetAttribute("ThemeRole", "TabBackground")
				local oldMarker = CurrentTab.Button:FindFirstChild("ActiveMarker")
				if oldMarker then oldMarker.Visible = false end
				CurrentTab.Label.TextColor3 = Theme.TextDark
				if CurrentTab.Icon and CurrentTab.Icon:IsA("TextLabel") then CurrentTab.Icon.TextColor3 = Theme.TextDark end
				local oldStroke = CurrentTab.Button:FindFirstChild("TabBorder")
				if oldStroke then oldStroke.Color = Theme.TabBorder end
			end

			Page.Visible = true
			TabBtn.BackgroundColor3 = Theme.TabSelected
			TabBtn:SetAttribute("ThemeRole", "TabSelected")
			ActiveMarker.Visible = true
			ActiveMarker.BackgroundColor3 = Theme.Accent
			TabStroke.Transparency = 0.08
			TabLabel.TextColor3 = Theme.Text
			if iconWidget and iconWidget:IsA("TextLabel") then iconWidget.TextColor3 = Theme.Text end
			TabStroke.Color = Theme.Accent
			CurrentTab = Tab
            if OnNativeSelection then OnNativeSelection(Tab) end
		end
        Tab._SelectNative=SelectNativeTab
        TabBtn.Activated:Connect(SelectNativeTab)

		table.insert(Tabs, Tab)
		local nextY = 8
		for _, tabItem in ipairs(Tabs) do
			tabItem.Button.Position = UDim2.new(0, 6, 0, nextY)
			nextY = nextY + tabItem.Button.Size.Y.Offset + 4
		end
		TabFrame.CanvasSize = UDim2.new(0, 0, 0, nextY + 4)

		if #Tabs == 1 then
			Page.Visible = true
			TabBtn.BackgroundColor3 = Theme.TabSelected
			TabBtn:SetAttribute("ThemeRole", "TabSelected")
			ActiveMarker.Visible = true
			ActiveMarker.BackgroundColor3 = Theme.Accent
			TabStroke.Transparency = 0.08
			TabLabel.TextColor3 = Theme.Text
			if iconWidget and iconWidget:IsA("TextLabel") then iconWidget.TextColor3 = Theme.Text end
			TabStroke.Color = Theme.Accent
			CurrentTab = Tab
		end

        if AttachAuraTab then AttachAuraTab(Tab) end
		return Tab
	end

