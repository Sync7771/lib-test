function Tab:CreateTooltip(options)
    options=asopts(options)
    local root,handle=createRow(self,options,62)
    local w=self.Window
    local hint=textbutton(root,w,"?","AccentSoft")
    handle:Action(hint,33,33)
    hint.AnchorPoint=Vector2.new(1,.5)
    hint.Position=UDim2.new(1,-16,.5,0)
    local bubble=frame(w.Gui,w,"Hover",11)
    bubble.Name="Tooltip";bubble.Visible=false
    bubble.Size=UDim2.fromOffset(250,75)
    bubble.ZIndex=70
    stroke(bubble,w.Theme.Stroke,.15)
    local description=textlabel(bubble,w,options.Content or options.Description or "Tip",12,false)
    description.TextWrapped=true
    description.TextTruncate=Enum.TextTruncate.None
    description.Size=UDim2.new(1,-18,1,-12)
    description.Position=UDim2.fromOffset(9,6)
    description.ZIndex=71
    local function show()
        local view=screenSize();local location=hint.AbsolutePosition
        local pos=Vector2.new(math.min(location.X+35,view.X-255),math.min(location.Y+8,view.Y-80))
        bubble.Position=UDim2.fromOffset(math.max(0,pos.X),math.max(0,pos.Y))
        bubble.Visible=true
    end
    track(w,hint.MouseEnter,show)
    track(w,hint.MouseLeave,function()bubble.Visible=false end)
    track(w,hint.Activated,function()bubble.Visible=not bubble.Visible;if bubble.Visible then show()end end)
    local destroy=handle.Destroy
    function handle:Destroy()bubble:Destroy();destroy(self)end
    handle._skipSave=true
    return handle
end

local notificationPalette={success="Success",warning="Warning",warn="Warning",error="Danger",info="Accent"}
function Aura:Notify(options)
    options=options or {}
    local w=options.Window or Aura._lastWindow
    if not w or w.Destroyed then
        warn("[AURA NOTIFY]",tostring(options.Title or "Info"),tostring(options.Content or ""))
        return
    end
    if not w._notificationStack or not w._notificationStack.Parent then
        local stack=new("Frame",{
            Name="Notifications",BackgroundTransparency=1,
            AnchorPoint=Vector2.new(1,0),Position=UDim2.new(1,-14,0,16),
            Size=UDim2.new(0,280,1,-30),ZIndex=80,
        },w.Gui)
        list(stack,8)
        w._notificationStack=stack
    end
    local root=frame(w._notificationStack,w,"Surface",14)
    root.ZIndex=81
    root.Size=UDim2.new(1,0,0,77)
    stroke(root,w.Theme.Stroke,.14)
    local tone=notificationPalette[tostring(options.Type or "info"):lower()] or "Accent"
    local stripe=frame(root,w,tone,5)
    stripe.ZIndex=82;stripe.Size=UDim2.fromOffset(4,52)
    stripe.Position=UDim2.fromOffset(10,12)
    local title=textlabel(root,w,options.Title or "Notification",13,true)
    title.Position=UDim2.fromOffset(23,9);title.Size=UDim2.new(1,-37,0,23)
    title.ZIndex=82
    local message=textlabel(root,w,options.Content or "",11,false,"Muted")
    message.Position=UDim2.fromOffset(23,32)
    message.Size=UDim2.new(1,-35,0,36)
    message.TextWrapped=true;message.TextTruncate=Enum.TextTruncate.AtEnd
    message.ZIndex=82
    root.BackgroundTransparency=1
    tween(w,root,{BackgroundTransparency=0},.25)
    local duration=math.clamp(tonumber(options.Duration) or 4,.5,25)
    task.delay(duration,function()
        if root.Parent then
            local anim=tween(w,root,{BackgroundTransparency=1},.2)
            task.delay(w.Animations and .21 or 0,function()if root.Parent then root:Destroy()end end)
        end
    end)
    return root
end

-- Optional in-session profiles; disk persistence is handled separately.
function Window:SaveProfile(name)
    name=tostring(name or "Default")
    self.Profiles=self.Profiles or {}
    self.Profiles[name]=self:ExportConfig()
    return self.Profiles[name]~=nil
end
function Window:LoadProfile(name)
    self.Profiles=self.Profiles or {}
    local data=self.Profiles[tostring(name or "Default")]
    if not data then return false,"Profile not found" end
    return self:ImportConfig(data)
end
function Window:DeleteProfile(name)
    self.Profiles=self.Profiles or {}
    self.Profiles[tostring(name or "Default")]=nil
end
function Window:GetProfiles()
    self.Profiles=self.Profiles or {}
    local result={}
    for name in pairs(self.Profiles) do table.insert(result,name) end
    table.sort(result)
    return result
end
function Window:CreateProfilePanel()
    local tab=self:CreateTab({Name="Profiles",Icon="folder"})
    tab:CreateSection("IN-SESSION PROFILES")
    local name="Default"
    tab:CreateInput({Name="Profile name",Default=name,Placeholder="Type profile...",
