            if input.KeyCode~=Enum.KeyCode.Unknown then handle:Set(input.KeyCode);listening=false end
            return
        end
        if not processed and not UserInputService:GetFocusedTextBox() and input.KeyCode==current and current~=Enum.KeyCode.Unknown then
            callback(options.Callback,current)
        end
    end)
