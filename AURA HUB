	ApplyTheme = function()
		for _, object in ipairs(ScreenGui:GetDescendants()) do
			if object:IsA("TextLabel") or object:IsA("TextButton") or object:IsA("TextBox") then
				object.TextStrokeTransparency = 1
				RemoveTextHighlight(object)
			elseif object:IsA("UIStroke") then
				-- Keep borders crisp and subtle; never use thick/glowing-looking strokes.
				object.Thickness = math.min(object.Thickness, 1)
				object.Transparency = math.max(object.Transparency, 0.12)
			end
			local role = object:GetAttribute("ThemeRole")

			if object:IsA("GuiObject") and AcrylicTransparency[role] ~= nil and not (role == "Background" and object:IsA("ScrollingFrame")) and object:GetAttribute("AURA_TransparencyOverride")==nil then
				if object:GetAttribute("PDDEV_AcrylicManaged") ~= true then
					object:SetAttribute("PDDEV_PreAcrylicTransparency", object.BackgroundTransparency)
					object:SetAttribute("PDDEV_AcrylicManaged", true)
				end
				if AcrylicEnabled then
					object.BackgroundTransparency = AcrylicTransparency[role]
				else
					local originalTransparency = object:GetAttribute("PDDEV_PreAcrylicTransparency")
					if typeof(originalTransparency) == "number" then object.BackgroundTransparency = originalTransparency end
				end
			end

			if role then
				if role == "Background" then
					if object:IsA("GuiObject") then
						object.BackgroundColor3 = Theme.Background
					end

				elseif role == "TitleBar" then
					if object:IsA("GuiObject") then
						object.BackgroundColor3 = Theme.TitleBar
					end

				elseif role == "TabBackground" then
					if object:IsA("GuiObject") then
						object.BackgroundColor3 = Theme.TabBackground
					end

				elseif role == "TabSelected" then
					if object:IsA("GuiObject") then
						object.BackgroundColor3 = Theme.TabSelected
					end

				elseif role == "Button" then
					if object:IsA("GuiObject") then
						object.BackgroundColor3 = Theme.Button
					end
					if object:IsA("TextLabel") or object:IsA("TextButton") or object:IsA("TextBox") then
						object.TextColor3 = Theme.Text
						object.TextStrokeTransparency = 1
					end

				elseif role == "Text" then
					if object:IsA("TextLabel") or object:IsA("TextButton") or object:IsA("TextBox") then
						object.TextColor3 = Theme.Text
						object.TextStrokeTransparency = 1
					elseif object:IsA("ImageLabel") or object:IsA("ImageButton") then
						object.ImageColor3 = Theme.Text
					end

				elseif role == "TextDarkImage" then
                    if object:IsA("ImageLabel")or object:IsA("ImageButton")then object.ImageColor3=Theme.TextDark end
                elseif role == "TextDark" then
					if object:IsA("TextLabel") or object:IsA("TextButton") or object:IsA("TextBox") then
						object.TextColor3 = Theme.TextDark
						object.TextStrokeTransparency = 1
					end

				elseif role == "Accent" then
                    if object:IsA("UIStroke") then object.Color=Theme.Accent end
					if object:IsA("GuiObject") then
						object.BackgroundColor3 = Theme.Accent
					end

				elseif role == "ToggleOn" then
					if object:IsA("GuiObject") then
						object.BackgroundColor3 = Theme.ToggleOn
					end

				elseif role == "ToggleOff" then
					if object:IsA("GuiObject") then
						object.BackgroundColor3 = Theme.ToggleOff
					end

				elseif role == "Border" then
					if object:IsA("UIStroke") then
						object.Color = Theme.Border
					elseif object:IsA("GuiObject") then
						object.BackgroundColor3 = Theme.Border
					end

				elseif role == "TabBorder" then
					if object:IsA("UIStroke") then
						object.Color = Theme.TabBorder
						object.Thickness = 1
					elseif object:IsA("GuiObject") then
						object.BackgroundColor3 = Theme.TabBorder
					end
				elseif role == "TabText" then
					if object:IsA("TextLabel") then
						object.TextColor3 = (CurrentTab and CurrentTab.Label == object) and Theme.Text or Theme.TextDark
						object.TextStrokeTransparency = 1
					end
				elseif role == "TabIcon" then
					if object:IsA("TextLabel") then
						object.TextColor3 = (CurrentTab and CurrentTab.Icon == object) and Theme.Text or Theme.TextDark
						object.TextStrokeTransparency = 1
					end
				end
			end
		end
		
		-- Atualiza a cor do texto das tabs mesmo quando não estão selecionadas
		for _, tab in ipairs(Tabs) do
			if tab.Button then
				tab.Button.TextStrokeTransparency = 1
				if tab.Label then tab.Label.TextColor3 = (tab == CurrentTab) and Theme.Text or Theme.TextDark end
				if tab.Icon and tab.Icon:IsA("TextLabel") then
					tab.Icon.TextColor3 = (tab == CurrentTab) and Theme.Text or Theme.TextDark
				end
				local tabStroke = tab.Button:FindFirstChild("TabBorder")
				if tabStroke then
					tabStroke.Thickness = 1
					tabStroke.Transparency = 0.12
					tabStroke.Color = (tab == CurrentTab) and Theme.Accent or Theme.TabBorder
				end
			end
		end
	end

