    local min=tonumber(options.Min) or 0;local max=tonumber(options.Max) or 100
    if min>max then min,max=max,min end
    local step=math.max(.00001,tonumber(options.Increment) or 1)
    local readout=textlabel(root,w,"",12,true,"Accent")
    readout.Position=UDim2.new(1,-155,0,11);readout.Size=UDim2.fromOffset(140,22)
    readout.TextXAlignment=Enum.TextXAlignment.Right
    local base=frame(root,w,"Surface",7)
    base.Position=UDim2.fromOffset(18,75);base.Size=UDim2.new(1,-36,0,8)
