	ShowNotification = function(title, message, duration, kind)
		if message == nil then
			message = title
			title = "Notificação"
		end
		title = ValidateString(title, true) or "Notificação"
		message = ValidateString(message, true) or ""
		duration = math.max(0.5, tonumber(duration) or 3.5)
		kind = string.lower(tostring(kind or "info"))

		local kindColors = {
			info = Theme.Accent,
			success = Theme.Success,
			warning = Theme.Warning,
			error = Theme.Error,
