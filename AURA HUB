    message.TextWrapped=true;message.TextYAlignment=Enum.TextYAlignment.Top;message.TextTruncate=Enum.TextTruncate.None
    local bounds=TextService:GetTextSize(message.Text,message.TextSize,message.Font,Vector2.new(width-40,100000))
    local messageHeight=math.max(24,math.ceil(bounds.Y)+6)
    local contentHeight=math.min(messageHeight,math.max(50,screenSize().Y-200))
    content.Size=UDim2.new(1,-40,0,contentHeight);content.CanvasSize=UDim2.fromOffset(0,messageHeight)
    message.Size=UDim2.new(1,-6,0,messageHeight)
    local height=contentHeight+116;pane.Size=UDim2.fromOffset(width,height)
    local cancel=textbutton(pane,self,options.CancelText or "Cancelar","Surface")
    cancel.Position=UDim2.new(0,20,1,-48);cancel.Size=UDim2.new(.5,-26,0,32)
    local accept=textbutton(pane,self,options.ConfirmText or "Confirmar","AccentSoft")
    accept.Position=UDim2.new(.5,6,1,-48);accept.Size=UDim2.new(.5,-26,0,32)
    local handle={Root=shade,Closed=false}
    local links={};local window=self
    function handle:Close(accepted)
        if self.Closed then return end;self.Closed=true
        for _,link in ipairs(links) do link:Disconnect() end
        shade:Destroy();if window._modal==self then window._modal=nil end
        callback(accepted and options.OnConfirm or options.OnCancel)
        callback(options.Callback,not not accepted)
    end
    table.insert(links,track(self,cancel.Activated,function()handle:Close(false)end))
    table.insert(links,track(self,accept.Activated,function()handle:Close(true)end))
    table.insert(links,track(self,UserInputService.InputBegan,function(input,processed)
        if not processed and input.KeyCode==Enum.KeyCode.Escape then handle:Close(false) end
    end))
    if options.CloseOnOutside then table.insert(links,track(self,shade.Activated,function()handle:Close(false)end)) end
    self._modal=handle;return handle
end
