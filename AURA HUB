local function renderIcon(parent,w,value,size,role)
    local host=new("Frame",{Name="Icon",BackgroundTransparency=1,Size=UDim2.fromOffset(size or 22,size or 22)},parent)
    local raw=tostring(value or "circle")
    if type(value)=="table" then raw=tostring(value.Image or value.Id or value.Name or "circle") end
    local key=raw:lower():gsub("^lucide%-",""):gsub("^lucide:",""):gsub("^rbxassetid://", "rbxassetid://")
    key=ICON_ALIASES[key] or key
    local parts={}
    local function colored(obj,prop)
        bind(w,obj,prop,role or "Muted");table.insert(parts,{obj,prop});return obj
    end
    local shape=ICONS[key]
    if shape then
        for _,path in ipairs(shape) do
            if path.circle then
                local c=path.circle
                local ring=new("Frame",{BackgroundTransparency=1,BorderSizePixel=0,Position=UDim2.fromScale((c[1]-c[3])/24,(c[2]-c[3])/24),Size=UDim2.fromScale(c[3]*2/24,c[3]*2/24)},host)
                round(ring,99);colored(stroke(ring,w.Theme[role or "Muted"],0,1.7),"Color")
            else
                for i=2,#path do
                    local a,b=path[i-1],path[i]
                    local dx,dy=b[1]-a[1],b[2]-a[2]
                    local seg=new("Frame",{BorderSizePixel=0,AnchorPoint=Vector2.new(.5,.5),Position=UDim2.fromScale((a[1]+b[1])/48,(a[2]+b[2])/48),Size=UDim2.new(math.sqrt(dx*dx+dy*dy)/24,0,0,1.7),Rotation=math.deg(math.atan2(dy,dx))},host)
                    colored(seg,"BackgroundColor3");round(seg,3)
                end
            end
        end
    elseif raw:match("^%d+$") or raw:match("^rbxasset") or raw:match("^https?://") then
        local icon=new("ImageLabel",{BackgroundTransparency=1,Size=UDim2.fromScale(1,1),ScaleType=Enum.ScaleType.Fit,Image=raw:match("^%d+$") and "rbxassetid://"..raw or raw},host)
        if role then colored(icon,"ImageColor3") end
