    end
    function handle:Get()return {low,high}end
    local which=1;local held=false;local pointer
    local function fromInput(input)
        local f=math.clamp((input.Position.X-base.AbsolutePosition.X)/math.max(1,base.AbsoluteSize.X),0,1)
        if which==1 then handle:Set({min+f*(max-min),high}) else handle:Set({low,min+f*(max-min)}) end
    end
    track(w,hit.InputBegan,function(input)
        if input.UserInputType~=Enum.UserInputType.MouseButton1 and input.UserInputType~=Enum.UserInputType.Touch then return end
        pointer=input;held=true
        local f=math.clamp((input.Position.X-base.AbsolutePosition.X)/math.max(1,base.AbsoluteSize.X),0,1)
        local val=min+f*(max-min)
        which=math.abs(val-low)<math.abs(val-high) and 1 or 2
        fromInput(input)
    end)
    track(w,UserInputService.InputChanged,function(input)
        if held and pointer and (input==pointer or (pointer.UserInputType==Enum.UserInputType.MouseButton1 and input.UserInputType==Enum.UserInputType.MouseMovement)) then fromInput(input)end
    end)
    track(w,UserInputService.InputEnded,function(input)
        if pointer and (input==pointer or (pointer.UserInputType==Enum.UserInputType.MouseButton1 and input.UserInputType==Enum.UserInputType.MouseButton1)) then pointer=nil;held=false end
    end)
    handle:Set(options.Default or {min,max},true)
    return handle
end
