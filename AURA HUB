        local glyph=textlabel(host,w,raw,19,false,role or "Muted")
        glyph.Size=UDim2.fromScale(1,1);glyph.TextXAlignment=Enum.TextXAlignment.Center
        table.insert(parts,{glyph,"TextColor3"})
    end
    return host,function(color)
        for _,part in ipairs(parts) do if part[1].Parent then part[1][part[2]]=color end end
    end
end

local function encode(value)
    if typeof(value)=="Color3" then return {__aura="Color3",hex=hex(value)} end
    if typeof(value)=="EnumItem" then return {__aura="KeyCode",name=value.Name} end
    if typeof(value)=="Vector2" then return {__aura="Vector2",x=value.X,y=value.Y} end
    if type(value)=="table" then
        local out={};for k,v in pairs(value) do out[k]=encode(v) end;return out
    end
    return value
end
local function decode(value)
    if type(value)~="table" then return value end
    if value.__aura=="Color3" then return fromHex(value.hex) or BASE.Accent end
    if value.__aura=="KeyCode" then return normalizedKey(value.name) or Enum.KeyCode.Unknown end
    if value.__aura=="Vector2" then return Vector2.new(value.x or 0,value.y or 0) end
    local out={};for k,v in pairs(value) do out[k]=decode(v) end;return out
end

function Window:_history(flag,old,newValue)
    if self._applyingHistory then return end
    if old==newValue then return end
    table.insert(self._undo,{flag=flag,old=encode(old),new=encode(newValue)})
    if #self._undo>80 then table.remove(self._undo,1) end
    table.clear(self._redo)
end
function Window:Undo()
    local entry=table.remove(self._undo)
    if not entry then return false end
    local item=self.Flags[entry.flag]
    if item and item.Set then
        self._applyingHistory=true;item:Set(decode(entry.old));self._applyingHistory=false
        table.insert(self._redo,entry);return true
    end
    return false
end
function Window:Redo()
    local entry=table.remove(self._redo)
    if not entry then return false end
    local item=self.Flags[entry.flag]
    if item and item.Set then
        self._applyingHistory=true;item:Set(decode(entry.new));self._applyingHistory=false
        table.insert(self._undo,entry);return true
    end
    return false
end
