function Tab:CreateDataTable(options)
    options=asopts(options)
    local root,handle=createRow(self,options,56,true)
    local w=self.Window
    local columns=options.Columns or {"Valor"};if #columns==0 then columns={"Valor"} end
    local body=handle:Mount(100)
    local header=new("Frame",{BackgroundTransparency=1,BorderSizePixel=0,Size=UDim2.new(1,0,0,30)},body)
    local scroll=new("ScrollingFrame",{Name="TableRows",BackgroundTransparency=1,BorderSizePixel=0,Position=UDim2.fromOffset(0,36),Size=UDim2.new(1,0,1,-36),CanvasSize=UDim2.new(),ScrollBarThickness=3,ScrollingDirection=Enum.ScrollingDirection.Y},body)
    bind(w,scroll,"ScrollBarImageColor3","Accent");syncScroll(w,scroll,list(scroll,4),4)
    local entries,links,data={},{},{}
    local orderColumn,descending=nil,false
    local function cell(row,column,index)
        if type(row)~="table" then return row end
        local key=type(column)=="table" and (column.Key or index) or index
        return row[key]
    end
    local function render()
        for _,c in ipairs(links) do c:Disconnect() end;table.clear(links)
        for _,entry in ipairs(entries) do entry:Destroy() end;table.clear(entries)
        local visible={};for _,row in ipairs(data) do table.insert(visible,row) end
        if orderColumn then
            table.sort(visible,function(a,b)
                local x,y=cell(a,columns[orderColumn],orderColumn),cell(b,columns[orderColumn],orderColumn)
                if type(x)~="number" or type(y)~="number" then x,y=tostring(x or ""):lower(),tostring(y or ""):lower() end
                if descending then return x>y else return x<y end
            end)
        end
        local maxRows=math.clamp(tonumber(options.MaxRows) or 100,1,500)
        for rowIndex=1,math.min(#visible,maxRows) do
            local row=visible[rowIndex]
            local entry=textbutton(scroll,w,"","Surface");entry.Size=UDim2.new(1,-6,0,32);entry.LayoutOrder=rowIndex
            table.insert(entries,entry)
            for i,column in ipairs(columns) do
                local label=textlabel(entry,w,tostring(cell(row,column,i) or ""),12,false)
                label.Position=UDim2.new((i-1)/#columns,8,0,0);label.Size=UDim2.new(1/#columns,-14,1,0)
            end
            table.insert(links,track(w,entry.Activated,function()callback(options.Callback,row,rowIndex)end))
        end
        handle:SetBodyHeight(36+math.min(tonumber(options.Height) or 230,math.max(36,#entries*36)))
    end
    function handle:Sort(column,reverse)
        local index=tonumber(column)
        if not index or not columns[index] then return false end
        orderColumn=index;descending=reverse==true;render();return true
    end
    function handle:Refresh(rows)data={};for _,row in ipairs(rows or {}) do table.insert(data,row) end;render()end
    function handle:Get()local result={};for _,row in ipairs(data) do table.insert(result,row) end;return result end
    handle.Set=handle.Refresh
    for i,column in ipairs(columns) do
        local name=type(column)=="table" and (column.Name or column.Key or i) or column
        local button=textbutton(header,w,tostring(name),"AccentSoft")
        button.Position=UDim2.new((i-1)/#columns,0,0,0);button.Size=UDim2.new(1/#columns,-6,0,28)
        track(w,button.Activated,function()handle:Sort(i,orderColumn==i and not descending or false)end)
    end
    local destroy=handle.Destroy
    function handle:Destroy()for _,link in ipairs(links) do link:Disconnect() end;destroy(self)end
    handle._skipSave=true;handle:Refresh(options.Rows or options.Data or {});return handle
end

function Window:Dialog(options)
    options=options or {}
    if self._modal then self._modal:Close(false) end
    local shade=new("TextButton",{Name="DialogOverlay",Text="",AutoButtonColor=false,BackgroundColor3=C(0,0,0),BackgroundTransparency=.3,Size=UDim2.fromScale(1,1),BorderSizePixel=0,ZIndex=100},self.Gui)
    local pane=frame(shade,self,"SurfaceAlt",16)
    pane.AnchorPoint=Vector2.new(.5,.5);pane.Position=UDim2.fromScale(.5,.5);pane.ZIndex=2
    local width=math.min(420,screenSize().X-24)
    local title=textlabel(pane,self,options.Title or "Confirmar",17,true)
    title.Position=UDim2.fromOffset(20,16);title.Size=UDim2.new(1,-40,0,26)
    local content=new("ScrollingFrame",{BackgroundTransparency=1,BorderSizePixel=0,Position=UDim2.fromOffset(20,52),Size=UDim2.new(1,-40,0,100),CanvasSize=UDim2.new(),ScrollBarThickness=3,ScrollingDirection=Enum.ScrollingDirection.Y},pane)
