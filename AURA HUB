	-- Wrap by measured pixel width, including very long words without spaces.
	local function WrapTextToWidth(value, font, textSize, maxWidth)
		value = FixMojibake(tostring(value or ""))
		maxWidth = math.max(24, tonumber(maxWidth) or 80)
		local lines = {}

		local function Measure(line)
			return TextService:GetTextSize(line, textSize, font, Vector2.new(10000, 1000)).X
		end

		local function SplitLongWord(word)
			local chars = {}
			local i = 1
			while i <= #word do
				local first = string.byte(word, i)
				local length = 1
				if first >= 240 then length = 4
				elseif first >= 224 then length = 3
				elseif first >= 192 then length = 2 end
				table.insert(chars, string.sub(word, i, math.min(#word, i + length - 1)))
				i += length
			end

			local chunks, chunk = {}, ""
			for _, char in ipairs(chars) do
				if chunk ~= "" and Measure(chunk .. char) > maxWidth then
					table.insert(chunks, chunk)
					chunk = char
				else
					chunk ..= char
				end
			end
			if chunk ~= "" then table.insert(chunks, chunk) end
			return chunks
		end

		for paragraph in (value .. "\n"):gmatch("(.-)\n") do
			if paragraph == "" then
				table.insert(lines, "")
			else
				local line = ""
				for word in paragraph:gmatch("%S+") do
					local candidate = (line == "") and word or (line .. " " .. word)
					if Measure(candidate) <= maxWidth then
						line = candidate
					else
						if line ~= "" then table.insert(lines, line); line = "" end
						if Measure(word) <= maxWidth then
							line = word
						else
							local chunks = SplitLongWord(word)
							for index = 1, #chunks - 1 do table.insert(lines, chunks[index]) end
							line = chunks[#chunks] or ""
						end
					end
				end
				if line ~= "" then table.insert(lines, line) end
			end
		end

		return table.concat(lines, "\n")
	end

	-- Manually wrap labels by their current pixel width. This is reliable for
	-- labels inside ScrollingFrames and also responds when the main window resizes.
	local function SetupResponsiveText(label, initialText, minimumHeight)
		local rawText = FixMojibake(tostring(initialText or ""))
		local formatting = false
		local lastFormattedText = nil
		local lastWidth = -1

		local function Refresh(force)
			if not label.Parent then return end
			local width = label.AbsoluteSize.X
			if width <= 1 then return end
			if not force and math.abs(width - lastWidth) < 1 then return end
			lastWidth = width

			local wrapped = WrapTextToWidth(rawText, label.Font, label.TextSize, width)
			local bounds = TextService:GetTextSize(
				wrapped,
				label.TextSize,
				label.Font,
				Vector2.new(width, 10000)
			)
			local height = math.max(tonumber(minimumHeight) or (label.TextSize + 4), math.ceil(bounds.Y) + 3)
			local oldSize = label.Size
			formatting = true
			label.TextWrapped = false -- text is explicitly wrapped above, preventing overflow
			label.TextTruncate = Enum.TextTruncate.None
			lastFormattedText = wrapped
			label.Text = wrapped
			label.Size = UDim2.new(oldSize.X.Scale, oldSize.X.Offset, 0, height)
			formatting = false
		end

		label:GetPropertyChangedSignal("Text"):Connect(function()
			if formatting or label.Text == lastFormattedText then return end
			rawText = FixMojibake(label.Text)
			lastWidth = -1
			task.defer(function() Refresh(true) end)
		end)
		label:GetPropertyChangedSignal("TextSize"):Connect(function()
			lastWidth = -1
			task.defer(function() Refresh(true) end)
		end)
		label:GetPropertyChangedSignal("Font"):Connect(function()
			lastWidth = -1
			task.defer(function() Refresh(true) end)
		end)
		label:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
			task.defer(function() Refresh(false) end)
		end)
		task.defer(function() Refresh(true) end)
		return function(newText)
			rawText = FixMojibake(tostring(newText or ""))
			lastWidth = -1
			Refresh(true)
		end
	end

