        tag.Position=UDim2.new(x,0,0,154);tag.Size=UDim2.new(1/3,-8,0,16)
        local field=new("TextBox",{Text="0",ClearTextOnFocus=false,BackgroundColor3=w.Theme.Surface,TextColor3=w.Theme.Text,Font=Enum.Font.Gotham,TextSize=12,BorderSizePixel=0,Position=UDim2.new(x,0,0,176),Size=UDim2.new(1/3,-8,0,32)},body)
        round(field,7);bind(w,field,"BackgroundColor3","Surface");bind(w,field,"TextColor3","Text")
        fields[i]=field
    end
    local tag=textlabel(body,w,"HEXADECIMAL",10,true,"Muted")
    tag.Position=UDim2.fromOffset(0,218);tag.Size=UDim2.new(1,0,0,16)
    local hexField=new("TextBox",{Text="",ClearTextOnFocus=false,BackgroundColor3=w.Theme.Surface,TextColor3=w.Theme.Text,Font=Enum.Font.Gotham,TextSize=12,BorderSizePixel=0,Position=UDim2.fromOffset(0,240),Size=UDim2.new(1,0,0,32)},body)
    round(hexField,7);bind(w,hexField,"BackgroundColor3","Surface");bind(w,hexField,"TextColor3","Text")
    local function paint()
        preview.BackgroundColor3=color;preview.Text=hex(color)
        local luma=.2126*color.R+.7152*color.G+.0722*color.B
        preview.TextColor3=luma>.55 and C(10,16,12) or C(255,255,255)
        sv.BackgroundColor3=Color3.fromHSV(hue,1,1)
        marker.Position=UDim2.fromScale(saturation,1-brightness)
        hueMark.Position=UDim2.new(0,-2,hue,0)
        hexField.Text=hex(color)
        for i,v in ipairs({color.R,color.G,color.B}) do fields[i].Text=tostring(math.floor(v*255+.5)) end
    end
    local dragging=false;local beforeDrag
    function handle:Set(v,silent)
        if type(v)=="string" then v=fromHex(v) end
        if typeof(v)~="Color3" then return false end
        local old=color;color=v
        local h,sat,val=v:ToHSV()
        if not dragging then
            if sat>0 and val>0 then hue=h end
            saturation=sat;brightness=val
        end
        paint()
        if dragging then if not silent then callback(options.Callback,color) end
        else commit(self,old,color,options.Callback,silent) end
        return true
    end
    function handle:Get()return color end
    function handle:RefreshVisual()paint()end
    local function expand(v)
        expanded=v;handle:SetBodyHeight(v and 272 or 0)
    end
    function handle:Open()expand(true)end
    function handle:Close()expand(false)end
    track(w,preview.Activated,function()expand(not expanded)end)
    local function drag(input,first,isHue)
        if first then
            if dragging then return false end
            beforeDrag=color;dragging=true
        end
        if isHue then hue=math.clamp((input.Position.Y-hueBar.AbsolutePosition.Y)/math.max(1,hueBar.AbsoluteSize.Y),0,1)
        else
            saturation=math.clamp((input.Position.X-sv.AbsolutePosition.X)/math.max(1,sv.AbsoluteSize.X),0,1)
            brightness=1-math.clamp((input.Position.Y-sv.AbsolutePosition.Y)/math.max(1,sv.AbsoluteSize.Y),0,1)
        end
        handle:Set(Color3.fromHSV(hue,saturation,brightness))
    end
    local function finish()
        if dragging then dragging=false;w:_history(handle.Flag,beforeDrag,color) end
    end
    bindPlane(self,svHit,function(input,first)return drag(input,first,false)end,finish)
    bindPlane(self,hueHit,function(input,first)return drag(input,first,true)end,finish)
    for _,field in ipairs(fields) do
        track(w,field.FocusLost,function()
            local r,g,b=tonumber(fields[1].Text),tonumber(fields[2].Text),tonumber(fields[3].Text)
            if r and g and b then handle:Set(C(math.clamp(r,0,255),math.clamp(g,0,255),math.clamp(b,0,255))) else paint() end
        end)
    end
    track(w,hexField.FocusLost,function()if not handle:Set(hexField.Text) then paint() end end)
    handle:Set(color,true);return handle
end
