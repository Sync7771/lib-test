end
local function bind(w, obj, property, role)
    obj[property]=w.Theme[role]
    table.insert(w._themeBindings,{object=obj,property=property,role=role})
    return obj
end
local function frame(parent, w, role, radius, clip)
    local f=new(clip and "CanvasGroup" or "Frame",{BackgroundColor3=w.Theme[role or "Surface"],BorderSizePixel=0},parent)
    local corner=radius or 12
    if corner>=7 and corner<=17 then corner=corner+3 end
    round(f,corner); bind(w,f,"BackgroundColor3",role or "Surface")
    return f
end
local function textlabel(parent,w,value,size,bold,role)
