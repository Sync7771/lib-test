	-- V4 public API adapter: support both dot and colon calls on the window.
	local function UnpackWindowArgs(a, b, c, d)
		if a == WindowAPI then return b, c, d end
		return a, b, c
	end
	WindowAPI.CreateTab = function(a, b, c)
		local name, icon = UnpackWindowArgs(a, b, c)
		return CreateTab(name, icon)
	end
	WindowAPI.RegisterTheme = function(a, b, c)
		local name, colors
		if a == WindowAPI then name, colors = b, c else name, colors = a, b end
		return RegisterTheme(name, colors)
	end
	WindowAPI.SetTheme = function(a, b)
		local themeName = (a == WindowAPI) and b or a
		return SetTheme(themeName)
	end
	WindowAPI.GetTheme = function(a, b)
		local themeName = (a == WindowAPI) and b or a
		return GetTheme(themeName)
	end
	WindowAPI.GetAllThemes = function()
		return GetAllThemes()
	end
	WindowAPI.SetAcrilic = function(a, b)
		local enabled = (a == WindowAPI) and b or a
		return SetAcrilic(enabled)
	end
	WindowAPI.GetAcrilic = function() return GetAcrilic() end
	WindowAPI.SetAcrylic = WindowAPI.SetAcrilic
	WindowAPI.GetAcrylic = WindowAPI.GetAcrilic
	WindowAPI.ApplyTheme = function()
		return ApplyTheme()
	end
	WindowAPI.Notification = function(a, b, c, d, e)
		local title, message, duration, kind
		if a == WindowAPI then title, message, duration, kind = b, c, d, e
		else title, message, duration, kind = a, b, c, d end
		return ShowNotification(title, message, duration, kind)
	end
	WindowAPI.Notify = WindowAPI.Notification
	WindowAPI.AddNotification = WindowAPI.Notification
	WindowAPI.AddMinimizeButton = function(a, b)
		local options = (a == WindowAPI) and b or a
		return AddMinimizeButton(options)
	end
	WindowAPI.Minimize = function()
		return ToggleMinimize()
	end
	WindowAPI.Destroy = function()
		if ScreenGui and ScreenGui.Parent then ScreenGui:Destroy() end
	end

