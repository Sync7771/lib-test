function Window:_emit(event,...)
    local listeners={};for _,listener in ipairs((self._events or {})[event] or {}) do table.insert(listeners,listener) end
    for _,listener in ipairs(listeners) do
        if listener.Connected then callback(listener.Callback,...) end
    end
end
function Window:On(event,fn)
    assert(type(fn)=="function","On expects a callback")
    self._events=self._events or {};self._events[event]=self._events[event] or {}
    local listener={Connected=true,Callback=fn}
    local listeners=self._events[event]
    function listener:Disconnect()
        self.Connected=false;self.Callback=nil
        for i,item in ipairs(listeners) do if item==self then table.remove(listeners,i);break end end
    end
    table.insert(self._events[event],listener);return listener
end
function Window:OnDestroy(fn)
    assert(type(fn)=="function","OnDestroy expects a callback")
    table.insert(self._cleanup,fn);return self
end
