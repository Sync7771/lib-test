		BarCorner.CornerRadius = UDim.new(0, 5)
		BarCorner.Parent = Bar

		-- Calculate initial percent (safe from division by zero)
		local function GetPercent(value)
			if max == min then return 0 end
			return Clamp((value - min) / (max - min), 0, 1)
		end

		local percent = GetPercent(default)
		local currentValue = default

		local Fill = Instance.new("Frame")
		Fill.Size = UDim2.new(percent, 0, 1, 0)
		Fill.BackgroundColor3 = Theme.Accent
		Fill.BorderSizePixel = 0
		Fill.Parent = Bar
		Fill:SetAttribute("ThemeRole", "Accent")

		local FillCorner = Instance.new("UICorner")
		FillCorner.CornerRadius = UDim.new(0, 5)
		FillCorner.Parent = Fill

		local Handle = Instance.new("Frame")
		Handle.Size = UDim2.new(0, 16, 0, 16)
		Handle.Position = UDim2.new(percent, -8, 0.5, -8)
		Handle.BackgroundColor3 = Color3.fromRGB(240, 240, 240)
		Handle.BorderSizePixel = 0
		Handle.ZIndex = 2
		Handle.Parent = Bar

		local HandleCorner = Instance.new("UICorner")
		HandleCorner.CornerRadius = UDim.new(0, 5)
		HandleCorner.Parent = Handle

		local draggingSlider = false

		local function UpdateSlider(input)
			if Bar.AbsoluteSize.X <= 0 then return end

			local newPercent = Clamp(
				(input.Position.X - Bar.AbsolutePosition.X) / Bar.AbsoluteSize.X,
				0,
				1
			)

			local value = math.floor(min + (max - min) * newPercent + 0.5)
			value = Clamp(value, min, max)
			currentValue = value
			percent = GetPercent(value)

			Fill.Size = UDim2.new(percent, 0, 1, 0)
			Handle.Position = UDim2.new(percent, -8, 0.5, -8)
			Label.Text = text .. ": " .. value

			if typeof(callback) == "function" then
				callback(value)
			end

			return value
		end

        local sliderPointer,previousScrolling
        Bar.Active=true;Handle.Active=true
        local function beginPointer(input)
            if sliderPointer then return end
            if input.UserInputType~=Enum.UserInputType.MouseButton1 and input.UserInputType~=Enum.UserInputType.Touch then return end
            sliderPointer=input;draggingSlider=true
            previousScrolling=page.ScrollingEnabled;page.ScrollingEnabled=false
            UpdateSlider(input)
        end
        local function releasePointer()
            if not sliderPointer then return end
            sliderPointer=nil;draggingSlider=false
            if page.Parent then page.ScrollingEnabled=previousScrolling end
        end
        Handle.InputBegan:Connect(beginPointer);Bar.InputBegan:Connect(beginPointer)
        ConnectGlobal(UIS.InputChanged,function(input)
            if sliderPointer and (input==sliderPointer or(sliderPointer.UserInputType==Enum.UserInputType.MouseButton1 and input.UserInputType==Enum.UserInputType.MouseMovement))then UpdateSlider(input)end
        end)
        ConnectGlobal(UIS.InputEnded,function(input)
            if sliderPointer and(input==sliderPointer or(sliderPointer.UserInputType==Enum.UserInputType.MouseButton1 and input.UserInputType==Enum.UserInputType.MouseButton1))then releasePointer()end
        end)
        ConnectGlobal(UIS.WindowFocusReleased,releasePointer)
        Frame.Destroying:Connect(releasePointer)

		-- Return API
		local SliderAPI = {}
		function SliderAPI.SetValue(value,silent)
			value = Clamp(math.floor((tonumber(value) or min) + 0.5), min, max)
			currentValue = value
			percent = GetPercent(value)
			Fill.Size = UDim2.new(percent, 0, 1, 0)
			Handle.Position = UDim2.new(percent, -8, 0.5, -8)
			Label.Text = text .. ": " .. value
			if not silent and typeof(callback) == "function" then callback(value) end
		end
		function SliderAPI.GetValue()
			return currentValue
		end

		return SliderAPI
	end

