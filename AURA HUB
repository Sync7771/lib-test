    return CoreGui
end
local function screenSize()
    local camera=workspace.CurrentCamera
    if camera then return camera.ViewportSize end
    return Vector2.new(1280,720)
end
local function clampSize(w,desired)
    local view=screenSize()
    local min=w.MinSize;local max=w.MaxSize
    local upperX=math.max(160,math.min(max.X,view.X-20))
    local upperY=math.max(160,math.min(max.Y,view.Y-20))
    return Vector2.new(math.clamp(desired.X,math.min(min.X,upperX),upperX),
        math.clamp(desired.Y,math.min(min.Y,upperY),upperY))
end
local function clampPosition(w,pos)
    local view=screenSize();local size=(w.Minimized and w._unminimizedSize) or w:GetSize()
    return UDim2.fromOffset(math.clamp(pos.X,4,math.max(4,view.X-size.X-4)),
        math.clamp(pos.Y,4,math.max(4,view.Y-size.Y-4)))
end
local function attachDrag(w,grip,target)
    local active,begin,origin,inputRef=nil,nil,nil,nil
    track(w,grip.InputBegan,function(input)
        if input.UserInputType~=Enum.UserInputType.MouseButton1 and input.UserInputType~=Enum.UserInputType.Touch then return end
        active=true;begin=input.Position;origin=Vector2.new(target.Position.X.Offset,target.Position.Y.Offset);inputRef=input
    end)
    track(w,UserInputService.InputChanged,function(input)
        if not active then return end
        if (inputRef.UserInputType==Enum.UserInputType.MouseButton1 and input.UserInputType==Enum.UserInputType.MouseMovement) or input==inputRef then
            local d=input.Position-begin
            local wanted=Vector2.new(origin.X+d.X,origin.Y+d.Y)
            if target==w.Root then
                target.Position=clampPosition(w,wanted)
            else
                local view=screenSize();local size=target.AbsoluteSize
                target.Position=UDim2.fromOffset(math.clamp(wanted.X,0,math.max(0,view.X-size.X)),
                    math.clamp(wanted.Y,0,math.max(0,view.Y-size.Y)))
            end
        end
    end)
    track(w,UserInputService.InputEnded,function(input)
        if input==inputRef or (inputRef and inputRef.UserInputType==Enum.UserInputType.MouseButton1 and input.UserInputType==Enum.UserInputType.MouseButton1) then
            active=false;inputRef=nil
        end
    end)
end
