function Tab:CreatePlayerList(options)
    options=asopts(options);options.Name=options.Name or "Jogadores online"
    local root,handle=createRow(self,options,66,true)
    local w=self.Window
    local maxHeight=math.clamp(tonumber(options.Height) or 310,110,650)
    local body=handle:Mount(110)
    local search=new("TextBox",{Name="PlayerSearch",Text="",PlaceholderText="Buscar nome ou @usuario...",ClearTextOnFocus=false,TextXAlignment=Enum.TextXAlignment.Left,BackgroundColor3=w.Theme.Surface,TextColor3=w.Theme.Text,PlaceholderColor3=w.Theme.Muted,Font=Enum.Font.Gotham,TextSize=12,BorderSizePixel=0,Size=UDim2.new(1,0,0,36)},body)
    round(search,8);padding(search,12,0,12,0)
    bind(w,search,"TextColor3","Text");bind(w,search,"BackgroundColor3","Surface");bind(w,search,"PlaceholderColor3","Muted")
    local count=textlabel(body,w,"",11,false,"Muted")
    count.Position=UDim2.fromOffset(0,44);count.Size=UDim2.new(1,0,0,18)
    local scroller=new("ScrollingFrame",{Name="PlayerRows",BackgroundTransparency=1,BorderSizePixel=0,Position=UDim2.fromOffset(0,70),Size=UDim2.new(1,0,1,-70),CanvasSize=UDim2.new(),ScrollBarThickness=3,ScrollingDirection=Enum.ScrollingDirection.Y,ClipsDescendants=true},body)
    bind(w,scroller,"ScrollBarImageColor3","Accent")
    syncScroll(w,scroller,list(scroller,7),4)
    local empty=textlabel(body,w,"Nenhum jogador encontrado.",12,false,"Muted")
    empty.Position=UDim2.fromOffset(0,86);empty.Size=UDim2.new(1,-12,0,30)
    local entries,chosen={},{}
    local multi=options.Multi==true
    local function selectedPlayers()
        local result={}
        for _,p in ipairs(Players:GetPlayers()) do if chosen[p.UserId] then table.insert(result,p) end end
        table.sort(result,function(a,b)return a.Name:lower()<b.Name:lower()end)
        return result
    end
    local function paint()
        for id,entry in pairs(entries) do
            local active=chosen[id]
            entry.Row.BackgroundColor3=w.Theme[active and "AccentSoft" or "Surface"]
            entry.Display.TextColor3=w.Theme[active and "Accent" or "Text"]
            entry.Mark.Visible=active==true
        end
    end
    local function filter()
        local q=search.Text:lower():gsub("^%s+",""):gsub("%s+$",""):gsub("^@","")
        local shown,total=0,0
        for _,entry in pairs(entries) do
            total=total+1
            local p=entry.Player
            local show=q=="" or p.Name:lower():find(q,1,true)~=nil or p.DisplayName:lower():find(q,1,true)~=nil
            entry.Row.Visible=show
            if show then shown=shown+1 end
        end
        count.Text=tostring(shown).." / "..tostring(total).." jogadores  •  "..tostring(#selectedPlayers()).." selecionados"
        empty.Visible=shown==0
        if options.AutoSize==false then handle:SetBodyHeight(maxHeight)
        else
            local rowsHeight=shown==0 and 38 or shown*62+math.max(0,shown-1)*7+4
            handle:SetBodyHeight(70+math.min(math.max(38,maxHeight-70),rowsHeight))
        end
    end
    local function remove(id)
        local entry=entries[id]
        if not entry then return end
        entry.Click:Disconnect();entry.Changed:Disconnect();entry.Row:Destroy();entries[id]=nil;chosen[id]=nil
    end
    local function add(p)
        if entries[p.UserId] then return end
        local row=textbutton(scroller,w,"","Surface")
        row.Size=UDim2.new(1,-8,0,62);row.ClipsDescendants=true
        local avatar=new("ImageLabel",{Name="Avatar",BackgroundColor3=w.Theme.SurfaceAlt,BorderSizePixel=0,Size=UDim2.fromOffset(40,40),Position=UDim2.fromOffset(11,11),ScaleType=Enum.ScaleType.Fit},row)
        round(avatar,20);bind(w,avatar,"BackgroundColor3","SurfaceAlt")
        local display=textlabel(row,w,p.DisplayName,12,true)
        display.Position=UDim2.fromOffset(62,11);display.Size=UDim2.new(1,-88,0,20)
        local username=textlabel(row,w,"@"..p.Name,10,false,"Muted")
        username.Position=UDim2.fromOffset(62,34);username.Size=UDim2.new(1,-88,0,16)
        local mark=frame(row,w,"Accent",3)
        mark.Size=UDim2.fromOffset(3,28);mark.Position=UDim2.new(1,-9,0,17);mark.Visible=false
        local entry={Row=row,Player=p,Display=display,Mark=mark};entries[p.UserId]=entry
        entry.Click=track(w,row.Activated,function()
            if multi then chosen[p.UserId]=not chosen[p.UserId]
            else chosen={};chosen[p.UserId]=true end
            paint();filter();callback(options.Callback,p,selectedPlayers())
        end)
        entry.Changed=track(w,p:GetPropertyChangedSignal("DisplayName"),function()display.Text=p.DisplayName;filter()end)
        task.spawn(function()
            local ok,url=pcall(Players.GetUserThumbnailAsync,Players,p.UserId,Enum.ThumbnailType.HeadShot,Enum.ThumbnailSize.Size100x100)
            if ok and avatar.Parent then avatar.Image=url end
        end)
    end
    local function refresh(exclude)
        if not root.Parent then return end
        local alive={};local sorted={}
        for _,p in ipairs(Players:GetPlayers()) do
            if p~=exclude then alive[p.UserId]=true;add(p);table.insert(sorted,p) end
        end
        local gone={};for id in pairs(entries) do if not alive[id] then table.insert(gone,id) end end
        for _,id in ipairs(gone) do remove(id) end
        table.sort(sorted,function(a,b)
            local x,y=a.DisplayName:lower(),b.DisplayName:lower()
            return x==y and a.Name:lower()<b.Name:lower() or x<y
        end)
        for i,p in ipairs(sorted) do entries[p.UserId].Row.LayoutOrder=i end
        paint();filter()
    end
    function handle:Refresh()refresh()end
    function handle:RefreshVisual()paint()end
    function handle:Get()local result=selectedPlayers();if multi then return result else return result[1] end end
    function handle:Set(value,silent)
        chosen={}
        local values=type(value)=="table" and value or {value}
        for _,v in ipairs(values) do
            for _,entry in pairs(entries) do
                local p=entry.Player
                if v==p or tostring(v)==tostring(p.UserId) or tostring(v):lower()==p.Name:lower() then
                    chosen[p.UserId]=true;if not multi then break end
                end
            end
            if not multi and next(chosen) then break end
        end
        paint();filter()
        if not silent then callback(options.Callback,self:Get(),selectedPlayers()) end
    end
    local added=track(w,Players.PlayerAdded,function()refresh()end)
    local removed=track(w,Players.PlayerRemoving,function(p)refresh(p)end)
    track(w,search:GetPropertyChangedSignal("Text"),function()scroller.CanvasPosition=Vector2.new();filter()end)
    local destroy=handle.Destroy
    function handle:Destroy()
        added:Disconnect();removed:Disconnect()
        local ids={};for id in pairs(entries) do table.insert(ids,id) end
        for _,id in ipairs(ids) do remove(id) end
        destroy(self)
    end
    handle._skipSave=true;refresh();return handle
end
