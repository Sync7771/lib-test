    local root,handle=createRow(self,{Name=options.Title or options.Name or "Info",Flag=options.Flag},60,true)
    local body=handle:Mount(30)
    local label=textlabel(body,self.Window,options.Content or options.Description or "",12,false,"Muted")
    label.TextWrapped=true;label.TextYAlignment=Enum.TextYAlignment.Top
    label.TextTruncate=Enum.TextTruncate.None
    local function resize()
        if not body.Parent then return end
        local width=math.max(80,body.AbsoluteSize.X)
        local bounds=TextService:GetTextSize(label.Text,12,label.Font,Vector2.new(width,100000))
        local h=label.Text=="" and 0 or math.max(20,math.ceil(bounds.Y)+4)
        label.Size=UDim2.new(1,0,0,h);handle:SetBodyHeight(h)
    end
    track(self.Window,body:GetPropertyChangedSignal("AbsoluteSize"),resize)
    function handle:Set(value,content)
        if type(value)=="table" then
            if value.Title then self.TitleLabel.Text=tostring(value.Title) end
            label.Text=tostring(value.Content or value.Description or "")
        elseif content~=nil then self.TitleLabel.Text=tostring(value);label.Text=tostring(content)
        else label.Text=tostring(value or "") end
        resize();self:Reflow()
    end
    function handle:Get()return label.Text end
    handle._skipSave=true;task.defer(resize);return handle
end
