function Window:SetSize(a,b)
    local desired=typeof(a)=="Vector2" and a or Vector2.new(tonumber(a) or 820,tonumber(b) or 560)
    local v=clampSize(self,desired)
    local pos=self.Root.Position
    local view=screenSize()
    -- Resize from the lower-right corner, keeping the upper-left corner fixed.
    local x=math.clamp(pos.X.Offset,4,math.max(4,view.X-164))
    local y=math.clamp(pos.Y.Offset,4,math.max(4,view.Y-164))
    v=Vector2.new(math.min(v.X,math.max(160,view.X-x-4)),math.min(v.Y,math.max(160,view.Y-y-4)))
    self.Root.Position=UDim2.fromOffset(x,y)
    if self.Minimized then
        self._unminimizedSize=v
        self.Root.Size=UDim2.fromOffset(v.X,64)
    else self.Root.Size=UDim2.fromOffset(v.X,v.Y) end
    return v
end
function Window:GetSize()
    return Vector2.new(self.Root.Size.X.Offset,self.Root.Size.Y.Offset)
end
function Window:Center()
    local view=screenSize();local sz=self:GetSize()
    self.Root.Position=UDim2.fromOffset(math.max(0,(view.X-sz.X)/2),math.max(0,(view.Y-sz.Y)/2))
end
function Window:Toggle(visible)
    if type(visible)=="boolean" then self.Root.Visible=visible else self.Root.Visible=not self.Root.Visible end
    if self.FloatingButton then self.FloatingButton.Visible=true end
    return self.Root.Visible
end
function Window:Minimize(state)
    if state==nil then state=not self.Minimized end
    state=not not state
    if state==self.Minimized then return end
    if state then
        self._unminimizedSize=self:GetSize()
        self.Minimized=true
        self.Main.Visible=false;self.Sidebar.Visible=false;self.ResizeHandle.Visible=false
        self.Root.Size=UDim2.fromOffset(self._unminimizedSize.X,64)
    else
        self.Minimized=false
        local size=self._unminimizedSize or Vector2.new(820,560)
        self.Root.Size=UDim2.fromOffset(size.X,size.Y)
        self.Main.Visible=true;self.Sidebar.Visible=true;self.ResizeHandle.Visible=true
    end
end
function Window:Destroy()
    if self.Destroyed then return end
    self.Destroyed=true
    for _,connection in ipairs(self._connections) do connection:Disconnect() end
    table.clear(self._connections)
    if self.Gui and self.Gui.Parent then self.Gui:Destroy() end
    if Aura._lastWindow==self then Aura._lastWindow=nil end
end

