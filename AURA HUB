function Window:_applySearch()
    if self.Destroyed then return end
    local query=(self.SearchBox and self.SearchBox.Text or ""):lower():gsub("^%s+",""):gsub("%s+$","")
    local function filterControls(controls,inherited)
        local count=0
        for _,control in ipairs(controls) do
            if control.Root and control.Root.Parent then
                local match=query=="" or inherited or (control._search or ""):find(query,1,true)~=nil
                if control._isGroup then
                    local children=filterControls(control.Controls,match)
                    local show=control._visible~=false and (match or children>0)
                    control.Root.Visible=show
                    control._searchExpanded=query~="" and children>0
                    control:_renderGroup()
                    if show then count=count+1 end
                else
                    local show=control._visible~=false and match
                    control.Root.Visible=show
                    if show then count=count+1 end
                end
            end
        end
        return count
    end
    local first
    for _,tab in ipairs(self.Tabs) do
        local tabMatch=query~="" and tab.Name:lower():find(query,1,true)~=nil
        local count=filterControls(tab.Controls,tabMatch)
        tab.Button.Visible=tab._visible~=false and (query=="" or tabMatch or count>0)
        if tab.Button.Visible and not first then first=tab end
    end
    if self.ActiveTab and not self.ActiveTab.Button.Visible then
        self.ActiveTab.Content.Visible=false
        if first then self:SelectTab(first) end
    elseif first and not self.ActiveTab then self:SelectTab(first)
    elseif self.ActiveTab and self.ActiveTab.Button.Visible then self.ActiveTab.Content.Visible=true end
end

