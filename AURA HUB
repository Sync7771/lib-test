    bind(w,stroke(b,w.Theme.Stroke,.65,1),"Color","Stroke")
    return b
end
local function tween(w, obj, properties, secs)
    if not obj or not obj.Parent then return end
    if w and not w.Animations then
        for k,v in pairs(properties) do obj[k]=v end
        return
    end
    local tw=TweenService:Create(obj,TweenInfo.new(secs or .18,Enum.EasingStyle.Quart,Enum.EasingDirection.Out),properties)
    tw:Play();return tw
end
local function callback(fn,...)
    if type(fn)~="function" then return end
    local pack=table.pack(...)
    task.spawn(function()
        local ok,err=pcall(fn,table.unpack(pack,1,pack.n))
        if not ok then warn("[AURA CALLBACK]",err) end
    end)
end
local function track(w,signal,fn)
    if #w._connections>600 then
        local live={};for _,c in ipairs(w._connections) do if c.Connected then table.insert(live,c) end end
        w._connections=live
    end
    local connection=signal:Connect(fn)
    table.insert(w._connections,connection)
    return connection
end
local function hover(w,b,roleNormal,roleHover)
    track(w,b.MouseEnter,function() if b.Parent then tween(w,b,{BackgroundColor3=w.Theme[roleHover or "Hover"]},.13) end end)
    track(w,b.MouseLeave,function() if b.Parent then tween(w,b,{BackgroundColor3=w.Theme[roleNormal or "SurfaceAlt"]},.13) end end)
end
local function asopts(arg)
    return type(arg)=="table" and arg or {Name=tostring(arg or "")}
end
local function limitedText(value,limit)
    local text=tostring(value or "")
    if not limit or limit<=0 then return text end
    local ok,index=pcall(utf8.offset,text,math.floor(limit)+1)
    if ok and index then return text:sub(1,index-1) end
    return text
end
local function normalizedKey(value)
    if typeof(value)=="EnumItem" then return value end
    if type(value)=="string" then local ok,key=pcall(function()return Enum.KeyCode[value]end);if ok then return key end end
    return nil
end
local function hex(color)
    return string.format("#%02X%02X%02X",math.floor(color.R*255+.5),math.floor(color.G*255+.5),math.floor(color.B*255+.5))
end
local function fromHex(raw)
    if type(raw)~="string" then return nil end
    local s=raw:gsub("%s",""):gsub("^#","")
    if #s==3 then s=s:sub(1,1):rep(2)..s:sub(2,2):rep(2)..s:sub(3,3):rep(2) end
    if #s~=6 or not s:match("^%x+$") then return nil end
    return C(tonumber(s:sub(1,2),16),tonumber(s:sub(3,4),16),tonumber(s:sub(5,6),16))
end
local function getParent()
    if player then
        local pg=player:FindFirstChildOfClass("PlayerGui") or player:WaitForChild("PlayerGui",5)
        if pg then return pg end
    end
    local ok,res=pcall(function()
        if type(gethui)=="function" then return gethui() end
        return CoreGui
    end)
    if ok then return res end
    return CoreGui
end
local function screenSize()
    local camera=workspace.CurrentCamera
    if camera then return camera.ViewportSize end
    return Vector2.new(1280,720)
end
local function clampSize(w,desired)
    local view=screenSize()
    local min=w.MinSize;local max=w.MaxSize
    local upperX=math.max(160,math.min(max.X,view.X-20))
    local upperY=math.max(160,math.min(max.Y,view.Y-20))
    return Vector2.new(math.clamp(desired.X,math.min(min.X,upperX),upperX),
        math.clamp(desired.Y,math.min(min.Y,upperY),upperY))
end
local function clampPosition(w,pos)
    local view=screenSize();local size=(w.Minimized and w._unminimizedSize) or w:GetSize()
    return UDim2.fromOffset(math.clamp(pos.X,4,math.max(4,view.X-size.X-4)),
        math.clamp(pos.Y,4,math.max(4,view.Y-size.Y-4)))
end
local function attachDrag(w,grip,target)
    local active,begin,origin,inputRef=nil,nil,nil,nil
    track(w,grip.InputBegan,function(input)
        if input.UserInputType~=Enum.UserInputType.MouseButton1 and input.UserInputType~=Enum.UserInputType.Touch then return end
        active=true;begin=input.Position;origin=Vector2.new(target.Position.X.Offset,target.Position.Y.Offset);inputRef=input
    end)
    track(w,UserInputService.InputChanged,function(input)
        if not active then return end
        if (inputRef.UserInputType==Enum.UserInputType.MouseButton1 and input.UserInputType==Enum.UserInputType.MouseMovement) or input==inputRef then
            local d=input.Position-begin
            local wanted=Vector2.new(origin.X+d.X,origin.Y+d.Y)
            if target==w.Root then
                target.Position=clampPosition(w,wanted)
            else
                local view=screenSize();local size=target.AbsoluteSize
                target.Position=UDim2.fromOffset(math.clamp(wanted.X,0,math.max(0,view.X-size.X)),
                    math.clamp(wanted.Y,0,math.max(0,view.Y-size.Y)))
            end
        end
    end)
    track(w,UserInputService.InputEnded,function(input)
        if input==inputRef or (inputRef and inputRef.UserInputType==Enum.UserInputType.MouseButton1 and input.UserInputType==Enum.UserInputType.MouseButton1) then
            active=false;inputRef=nil
        end
    end)
end
local Window={};Window.__index=Window
local Tab={};Tab.__index=Tab
local function syncScroll(w,scroll,layout,bottom)
    scroll.AutomaticCanvasSize=Enum.AutomaticSize.None
    local function update()
        if scroll.Parent then
            local extent=layout.AbsoluteContentSize
            if scroll.ScrollingDirection==Enum.ScrollingDirection.X then
                scroll.CanvasSize=UDim2.fromOffset(extent.X+12,0)
            else scroll.CanvasSize=UDim2.fromOffset(0,extent.Y+(bottom or 12)) end
        end
    end
    track(w,layout:GetPropertyChangedSignal("AbsoluteContentSize"),update)
    track(w,scroll:GetPropertyChangedSignal("AbsoluteSize"),update)
    task.defer(update)
    return update
end

