    for _,knob in ipairs({lo,hi}) do knob.AnchorPoint=Vector2.new(.5,.5);knob.Size=UDim2.fromOffset(17,17) end
    local hit=new("TextButton",{BackgroundTransparency=1,Text="",Size=UDim2.new(1,0,0,35),
        Position=UDim2.fromOffset(0,-12)},base)
    local low,high=min,max
    local function q(n)
        return math.clamp(min+math.floor((math.clamp(n,min,max)-min)/step+.5)*step,min,max)
    end
    function handle:Set(pair,silent)
        if type(pair)~="table" then return end
        local old={low,high}
        local a=q(tonumber(pair[1]) or low);local b=q(tonumber(pair[2]) or high)
        low=math.min(a,b);high=math.max(a,b)
        local f1=max==min and 0 or (low-min)/(max-min)
        local f2=max==min and 1 or (high-min)/(max-min)
        lo.Position=UDim2.new(f1,0,.5,0);hi.Position=UDim2.new(f2,0,.5,0)
        range.Position=UDim2.new(f1,0,0,0);range.Size=UDim2.new(f2-f1,0,1,0)
        readout.Text=string.format("%g — %g",low,high)
