end
function Window:SetTheme(nameOrTable)
    self.ThemeName=type(nameOrTable)=="string" and nameOrTable or "Custom"
    self.Theme=themeFor(nameOrTable)
    local live={}
    for _,ref in ipairs(self._themeBindings) do
        if ref.object.Parent then ref.object[ref.property]=self.Theme[ref.role];table.insert(live,ref) end
    end
    self._themeBindings=live
    for _,item in pairs(self.Flags) do if item.RefreshVisual then item:RefreshVisual() end end
    if self.ActiveTab then self:SelectTab(self.ActiveTab) end
    if self._accentGradient then
        self._accentGradient.Color=ColorSequence.new(self.Theme.Accent,self.Theme.AccentSoft)
