local function syncScroll(w,scroll,layout,bottom)
    scroll.AutomaticCanvasSize=Enum.AutomaticSize.None
    local function update()
        if scroll.Parent then
            local extent=layout.AbsoluteContentSize
            if scroll.ScrollingDirection==Enum.ScrollingDirection.X then
                scroll.CanvasSize=UDim2.fromOffset(extent.X+12,0)
            else scroll.CanvasSize=UDim2.fromOffset(0,extent.Y+(bottom or 12)) end
        end
    end
    track(w,layout:GetPropertyChangedSignal("AbsoluteContentSize"),update)
    track(w,scroll:GetPropertyChangedSignal("AbsoluteSize"),update)
    task.defer(update)
    return update
end

