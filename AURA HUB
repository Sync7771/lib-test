            local item=textbutton(holder,w,tostring(choice))
            item.Size=UDim2.new(1,-5,0,30);item.LayoutOrder=i
            table.insert(items,item)
            track(w,item.MouseButton1Click,function()
                local old=selectedList()
                if multi then
                    selected[tostring(choice)]=not selected[tostring(choice)]
                else selected=choice end
                updateTitle()
                commit(handle,old,selectedList(),options.Callback,false)
                if not multi then expand(false) end
            end)
        end
        if expanded then expand(true) end
    end
    function handle:Get()return selectedList()end
    function handle:Set(v,silent)
        local old=selectedList()
        if multi then
            selected={}
            if type(v)=="table" then for _,item in ipairs(v) do selected[tostring(item)]=true end end
        else selected=v end
        updateTitle()
        commit(self,old,selectedList(),options.Callback,silent)
    end
    function handle:Refresh(listValues)
        optionsList=listValues or {}
        rebuild();updateTitle()
    end
    track(w,trigger.MouseButton1Click,function()expand(not expanded)end)
    handle:Set(options.Default or (multi and {} or nil),true)
    rebuild()
    return handle
