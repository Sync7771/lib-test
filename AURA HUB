function UI.RegisterIcon(first,name,value)
    if first~=UI then value,name=name,first end
    if type(name)~="string" then return false end
    local key=AuraNormalizeIcon(name)
    local image=type(value)=="table" and (value.Image or value.Id) or value
    if type(image)=="number" then image="rbxassetid://"..tostring(math.floor(image))end
    if type(image)=="string" then
        if image:match("^%d+$")then image="rbxassetid://"..image end
        AuraTabAssets[key]=image;AuraSupport._SetIconAssets(AuraTabAssets,AuraTabAliases)
        return true
    end
    return false
end
function UI.GetIcon(first,name)
    name=first==UI and name or first
    local key=AuraNormalizeIcon(name);return AuraTabAssets[AuraTabAliases[key] or key]
end
function UI.Notify(first,options)
    if first~=UI then options=first end
    if UI._lastWindow then return UI._lastWindow:Notify(options) end
end
UI.Notification=UI.Notify
return UI
