	function AddDropdown(page, text, options, callback)
		if not page then error("Page required for AddDropdown", 2) end
		text = ValidateString(text, true) or "Dropdown"
		options = options or {}

		local Frame = Instance.new("Frame")
		Frame.Name = text
		Frame.Size = UDim2.new(1, -24, 0, 32)
		Frame.BackgroundTransparency = 1
		Frame.Parent = page

		local Btn = Instance.new("TextButton")
		Btn.Name = "DropdownButton"
		Btn.Size = UDim2.new(1, 0, 0, 32)
		Btn.BackgroundColor3 = Theme.Button
		Btn.BorderSizePixel = 0
		Btn.TextColor3 = Theme.Text
		Btn.TextSize = 13
		Btn.Font = Enum.Font.Gotham
		Btn.TextXAlignment = Enum.TextXAlignment.Left
		Btn.AutoButtonColor = false
		Btn.Parent = Frame
		Btn:SetAttribute("ThemeRole", "Button")
		Btn.TextStrokeTransparency = 1

		local Corner = Instance.new("UICorner")
		Corner.CornerRadius = UDim.new(0, 5)
		Corner.Parent = Btn

		local Stroke = Instance.new("UIStroke")
		Stroke.Color = Theme.Border
		Stroke.Thickness = 1
		Stroke.Parent = Btn
		Stroke:SetAttribute("ThemeRole", "Border")

		-- State
		local currentOptions = {}
		for _, opt in ipairs(options) do
			if typeof(opt) == "string" then
				table.insert(currentOptions, FixMojibake(opt))
			end
		end

		local currentValue = currentOptions[1]
		local open = false

		-- Dropdown list
		local List = Instance.new("ScrollingFrame")
		List.Name = "DropdownList"
		List.BackgroundColor3 = Theme.TitleBar
		List.BorderSizePixel = 0
		List.Visible = false
		List.ZIndex = 50
		List.Position = UDim2.new(0, 0, 0, 36)
		List.Parent = Frame

		List.ScrollBarThickness = 4
		List.ScrollBarImageColor3 = Theme.Border
		List.ScrollingDirection = Enum.ScrollingDirection.Y
		List.CanvasSize = UDim2.new(0, 0, 0, 0)
		List.AutomaticCanvasSize = Enum.AutomaticSize.Y
		List.ClipsDescendants = true

		List:SetAttribute("ThemeRole", "TitleBar")

		local ListCorner = Instance.new("UICorner")
		ListCorner.CornerRadius = UDim.new(0, 5)
		ListCorner.Parent = List

		local ListStroke = Instance.new("UIStroke")
		ListStroke.Color = Theme.Border
		ListStroke.Thickness = 1
		ListStroke.Parent = List
		ListStroke:SetAttribute("ThemeRole", "Border")

		local ListLayout = Instance.new("UIListLayout")
		ListLayout.SortOrder = Enum.SortOrder.LayoutOrder
		ListLayout.Padding = UDim.new(0, 0)
		ListLayout.Parent = List

		local ListPadding = Instance.new("UIPadding")
		ListPadding.PaddingTop = UDim.new(0, 2)
		ListPadding.PaddingBottom = UDim.new(0, 2)
		ListPadding.Parent = List

		-- Update button text
		local function UpdateButtonText()
			if currentValue then
				Btn.Text = "  " .. text .. ": " .. tostring(currentValue)
			else
				Btn.Text = "  " .. text .. ": Nenhum"
			end
		end

		-- Rebuild options list
		local function GetDropdownListHeight()
			return math.min(#currentOptions * DROPDOWN_ITEM_HEIGHT + 4, DROPDOWN_MAX_HEIGHT)
		end

		local function RebuildOptions()
			for _, child in ipairs(List:GetChildren()) do
				if child:IsA("TextButton") then
					child:Destroy()
				end
			end

			for i, opt in ipairs(currentOptions) do
				local OptBtn = Instance.new("TextButton")
				OptBtn.Size = UDim2.new(1, -4, 0, DROPDOWN_ITEM_HEIGHT)
				OptBtn.BackgroundTransparency = 1
				OptBtn.BackgroundColor3 = Theme.Button
				OptBtn.BorderSizePixel = 0
				OptBtn.Text = "  " .. tostring(opt)
				OptBtn.TextColor3 = Theme.Text
				OptBtn.TextSize = 13
				OptBtn.Font = Enum.Font.Gotham
				OptBtn.TextXAlignment = Enum.TextXAlignment.Left
				OptBtn.AutoButtonColor = false
				OptBtn.ZIndex = 51
				OptBtn.LayoutOrder = i
				OptBtn.Parent = List
				OptBtn:SetAttribute("ThemeRole", "Text")
				OptBtn.TextStrokeTransparency = 1

				OptBtn.MouseEnter:Connect(function()
					TweenService:Create(OptBtn, TweenInfo.new(0.1), {BackgroundColor3 = Theme.DropdownHover, BackgroundTransparency = 0}):Play()
				end)

				OptBtn.MouseLeave:Connect(function()
					TweenService:Create(OptBtn, TweenInfo.new(0.1), {BackgroundTransparency = 1}):Play()
				end)

				OptBtn.Activated:Connect(function()
					currentValue = opt
					UpdateButtonText()
					open = false
					List.Visible = false
					Frame.Size = UDim2.new(1, -24, 0, 32)

					if callback and typeof(callback) == "function" then
						callback(opt)
					end
				end)
			end

			List.Size = UDim2.new(1, 0, 0, GetDropdownListHeight())
			if open then
				Frame.Size = UDim2.new(1, -24, 0, 36 + GetDropdownListHeight())
			end
		end

		local function UpdateListPosition()
			List.Position = UDim2.new(0, 0, 0, 36)
			List.Size = UDim2.new(1, 0, 0, GetDropdownListHeight())
			if open then
				Frame.Size = UDim2.new(1, -24, 0, 36 + GetDropdownListHeight())
			else
				Frame.Size = UDim2.new(1, -24, 0, 32)
			end
		end

		-- Initialize
		UpdateButtonText()
		RebuildOptions()

		-- Toggle dropdown
		Btn.Activated:Connect(function()
			open = not open

			if open then
				UpdateListPosition()
				List.Visible = #currentOptions > 0
			else
				List.Visible = false
				Frame.Size = UDim2.new(1, -24, 0, 32)
			end
		end)

		-- Close dropdown when clicking outside
		ConnectGlobal(UIS.InputBegan, function(input)
			if input.UserInputType ~= Enum.UserInputType.MouseButton1 or not open then
				return
			end

			local mousePos = input.Position
			local buttonPos = Btn.AbsolutePosition
			local buttonSize = Btn.AbsoluteSize
			local listPos = List.AbsolutePosition
			local listSize = List.AbsoluteSize

			local insideButton = mousePos.X >= buttonPos.X and mousePos.X <= buttonPos.X + buttonSize.X
				and mousePos.Y >= buttonPos.Y and mousePos.Y <= buttonPos.Y + buttonSize.Y
			local insideList = mousePos.X >= listPos.X and mousePos.X <= listPos.X + listSize.X
				and mousePos.Y >= listPos.Y and mousePos.Y <= listPos.Y + listSize.Y

			if not insideButton and not insideList then
				open = false
				List.Visible = false
				Frame.Size = UDim2.new(1, -24, 0, 32)
			end
		end)

		-- API
		local DropdownAPI = {}

		function DropdownAPI.SetOptions(newOptions)
			if typeof(newOptions) ~= "table" then
				warn("Dropdown:SetOptions - expected table")
				return false
			end

			currentOptions = {}
			for _, opt in ipairs(newOptions) do
				if typeof(opt) == "string" then
					table.insert(currentOptions, FixMojibake(opt))
				end
			end

			if not table.find(currentOptions, currentValue) then
				currentValue = currentOptions[1]
			end

			UpdateButtonText()
			RebuildOptions()
			UpdateListPosition()
			return true
		end

		function DropdownAPI.SetValue(value)
			if typeof(value) ~= "string" then return false end
			if not table.find(currentOptions, value) then return false end

			currentValue = value
			UpdateButtonText()

			if callback and typeof(callback) == "function" then
				callback(value)
			end

			return true
		end

		function DropdownAPI.GetValue()
			return currentValue
		end

		function DropdownAPI.GetOptions()
			return CopyTable(currentOptions)
		end

		return DropdownAPI
	end

