                if type(action)=="table" then callback(action.Callback) end
            end))
        end
        expand(expanded)
    end
    track(w,trigger.Activated,function()expand(not expanded)end)
    function handle:Refresh(v)actions=v or {};render()end
    local destroy=handle.Destroy
    function handle:Destroy()for _,c in ipairs(links) do c:Disconnect() end;destroy(self)end
    handle._skipSave=true;render();return handle
end
function Window:EnableRainbow(enabled,speed)
    if self._rainbowConnection then self._rainbowConnection:Disconnect();self._rainbowConnection=nil end
    if not enabled then return end
    local last=0;local rate=tonumber(speed) or .16
    local c=RunService.Heartbeat:Connect(function()
        if self.Destroyed then return end
        local now=os.clock()
        if now-last<.12 then return end
        last=now
        self:SetAccent(Color3.fromHSV((now*rate)%1,.72,.95))
    end)
    self._rainbowConnection=c
    table.insert(self._connections,c)
end

