-- Each drag owns one pointer; touching elsewhere cannot move the selector.
local function bindPlane(tab,hit,update,finish)
    local w=tab.Window
    local pointer,previousScroll
    local function release()
        if not pointer then return end
        pointer=nil
        if tab.Content.Parent then tab.Content.ScrollingEnabled=previousScroll end
        if finish then finish() end
    end
    track(w,hit.InputBegan,function(input)
        if pointer or (input.UserInputType~=Enum.UserInputType.MouseButton1 and input.UserInputType~=Enum.UserInputType.Touch) then return end
        if update(input,true)==false then return end
        pointer=input;previousScroll=tab.Content.ScrollingEnabled;tab.Content.ScrollingEnabled=false
    end)
    track(w,UserInputService.InputChanged,function(input)
        if pointer and (input==pointer or (pointer.UserInputType==Enum.UserInputType.MouseButton1 and input.UserInputType==Enum.UserInputType.MouseMovement)) then update(input,false) end
    end)
    track(w,UserInputService.InputEnded,function(input)
        if pointer and (input==pointer or (pointer.UserInputType==Enum.UserInputType.MouseButton1 and input.UserInputType==Enum.UserInputType.MouseButton1)) then release() end
    end)
    track(w,UserInputService.WindowFocusReleased,release)
    track(w,tab.Content:GetPropertyChangedSignal("Visible"),function()if not tab.Content.Visible then release() end end)
    track(w,hit.Destroying,release)
end
