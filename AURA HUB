        if not ok then return false,res end
        data=res
    elseif type(json)=="table" then data=json end
    if type(data)~="table" then return false,"Invalid configuration" end
    if data.theme and PRESETS[data.theme] then self:SetTheme(data.theme) end
    if data.size then
        local size=decode(data.size)
        if typeof(size)=="Vector2" then self:SetSize(size.X,size.Y) end
    end
    self._pendingConfig=data.values or {}
    for flag,value in pairs(data.values or {}) do
        local item=self.Flags[flag]
        if item and item.Set then
            self._pendingConfig[flag]=nil
            local previous=self._applyingHistory;self._applyingHistory=true
            local ok,err=pcall(function()item:Set(decode(value),false)end)
            self._applyingHistory=previous
            if not ok then warn("[AURA CONFIG]",flag,err) end
        end
    end
