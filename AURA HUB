		function Tab.SetIcon(a, b)
			local newIcon = (a == Tab) and b or a
			if iconWidget then iconWidget:Destroy(); iconWidget = nil end
			iconType, iconValue = ResolveTabIcon(newIcon)
			Tab.Icon = nil
			if iconType == "image" then
				iconWidget = Instance.new("ImageLabel")
